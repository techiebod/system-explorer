__pycache__/
*.py[cod]

# Python build artifacts (pyproject.toml landed 2026-08-10)
/build/
/dist/
*.egg-info/

# uv writes this on every `uv run` (the convenient local way to run the
# conformance suite), and nothing consumes it: pyproject.toml is the single
# dependency truth and nix/package.nix resolves from it, so committing a
# second pinned resolution would be a second thing to disagree with the
# first. Ignored rather than committed, deliberately.
/uv.lock

# nix build symlinks
/result
/result-*
.direnv/

# Editor and OS cruft. Listed deliberately rather than left to a global
# ignore file: this repo is developed on macOS, and a single Finder visit
# would otherwise commit .DS_Store into a public tree.
.DS_Store
._*
.venv/
venv/
.idea/
.vscode/
*.swp
*~
