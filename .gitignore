__pycache__/
*.py[cod]

# Python build artifacts (pyproject.toml landed 2026-08-10)
/build/
/dist/
*.egg-info/

# uv writes this on every `uv run` (the convenient local way to run the
# conformance suite), and nothing consumes it: pyproject.toml is the single
# dependency truth and nix/package.nix resolves from it, so committing a
# second pinned resolution would be a second thing to disagree with the
# first. Ignored rather than committed, deliberately.
/uv.lock

# nix build symlinks
/result
/result-*
.direnv/

# Editor and OS cruft. Listed deliberately rather than left to a global
# ignore file: this repo is developed on macOS, and a single Finder visit
# would otherwise commit .DS_Store into a public tree.
.DS_Store
._*
.venv/
venv/
.idea/
.vscode/
*.swp
*~

# Substitution maps de-anonymise every specimen they were used on.
scrub-map*.json
*.scrub-map.json

# The keyed scrubber's state: maps are named <variant>.json under a scrub/
# state dir and the secret lives beside them. Both are refused inside a git
# tree by the tool itself; these patterns are the second lock for the day a
# state dir lands here anyway. harness/scrub/ holds the committed manifests,
# which carry no secrets, so it is re-included by name.
**/scrub/*.json
!harness/scrub/*.json
**/scrub/secret

# Built collector binaries. se-compare looks for them at go/bin/se-collect-*
# because the comparator must measure what would actually deploy, and a build
# step hidden inside a measurement is how a stale binary gets measured twice —
# so the path is a convention the tool depends on, and the 4.6 MB artefacts at
# it are not history.
/go/bin/
