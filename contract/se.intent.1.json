{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se.intent.1.json",
  "title": "System Explorer intent declaration",
  "description": "The estate's account of what should be true, held only by hubs, hashed and compared on federation (DESIGN 08, 21). Every fact derived from it carries declared kind. Never reaches a host. Closed throughout: a typo'd member here is not noise, it is a policy that silently stops existing — protection spelled wrongly validates as an estate with nothing to protect.",
  "type": "object",
  "required": [
    "schema",
    "estate",
    "revision",
    "reviewed",
    "membership"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "se.intent/1"
    },
    "estate": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "reviewed": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Review age is a fact: a declaration nobody has looked at in a year is a weaker claim (DESIGN 22). A date, not prose — the pattern stands beside the format because format is annotation-only under validators that were not asked to assert it."
    },
    "estate_hub": {
      "type": "string",
      "description": "The hub owning estate-scoped finding lifecycle; siblings serve those read-only (DESIGN 06, proposal)."
    },
    "membership": {
      "type": "object",
      "required": [
        "discovery",
        "hosts"
      ],
      "additionalProperties": false,
      "properties": {
        "discovery": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "collection",
              "independence"
            ],
            "additionalProperties": false,
            "properties": {
              "collection": {
                "type": "string"
              },
              "independence": {
                "type": "string",
                "description": "The failure-domain group. Two vantages on one group are redundancy; a second group is evidence (DESIGN 22)."
              }
            }
          }
        },
        "min_independent_sources": {
          "type": "integer",
          "minimum": 1
        },
        "min_vantages_per_source": {
          "type": "integer",
          "minimum": 1
        },
        "hosts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "machine_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Facts about the declared host, not its name: a changed machine-id under a declared host is a legible reinstall (DESIGN 16)."
              },
              "expected_units": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expected_disks": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "not_hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "denoted_by",
              "why",
              "by",
              "revision"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "denoted_by": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "source",
                    "name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              },
              "why": {
                "type": "string"
              },
              "by": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "description": "The revision that ruled. Bounded like the document's own revision: a negative one names a ruling no revision could have made."
              },
              "review_by": {
                "type": "string"
              }
            }
          },
          "description": "Classification with an author and a revision, never a filter list: an unclassified candidate is a finding until somebody rules (DESIGN 22)."
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "denoted_by"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "denoted_by": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "host",
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "host": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "description": "Estate identity: the only way two hosts' native names become one object — declaration, never correlation (DESIGN 16)."
    },
    "protection": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "owner",
          "class",
          "destinations"
        ],
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "destinations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "At least one, always: a protection row with an empty destination list reads as protected and protects to nowhere — the second founding failure in a single member."
          },
          "window": {
            "type": "string"
          }
        }
      }
    },
    "reachability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "permitted_ports"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string"
          },
          "permitted_ports": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    }
  }
}
