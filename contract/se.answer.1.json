{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se.answer.1.json",
  "title": "System Explorer problem-domain answer",
  "description": "A question as an object, minted at the hub: answer, verdict, basis, reach (DESIGN 24). Verdict and epistemic status are separate axes and must never merge; removing evidence may never improve either. Closed throughout: an answer is the top of the product, and an unmodelled member here is a claim no consumer was told how to read.",
  "type": "object",
  "required": [
    "id",
    "scope",
    "question",
    "answer",
    "verdict",
    "epistemic",
    "freshness",
    "basis",
    "reach"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^question:"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string",
      "description": "The answer first, in a sentence (DESIGN 27)."
    },
    "verdict": {
      "$ref": "se.vocabularies.1.json#/$defs/verdict"
    },
    "epistemic": {
      "$ref": "se.vocabularies.1.json#/$defs/epistemic"
    },
    "freshness": {
      "$ref": "se.vocabularies.1.json#/$defs/freshness"
    },
    "basis": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/basis_element"
      }
    },
    "reach": {
      "type": "object",
      "required": [
        "consulted"
      ],
      "additionalProperties": false,
      "description": "What was and was not seen. With coverage it carries appendix A's host_reachability vocabulary structurally: consulted holds the connected sources, dark and unswept name the other two states by member, the same way coverage's members carry the coverage vocabulary.",
      "properties": {
        "consulted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "declined": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host",
              "collection",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              },
              "reason": {
                "$ref": "se.vocabularies.1.json#/$defs/decline_reason"
              }
            }
          }
        },
        "dark": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host",
              "since"
            ],
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string"
              },
              "since": {
                "type": "string"
              }
            }
          }
        },
        "unswept": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Hosts not heard from since this hub started (DESIGN 06). Not dark: nobody-has-told-us is a different claim from told-us-and-stopped, and only one of them is evidence about the host — which is why it has no since."
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "description": "Identity lists, never bare counts (DESIGN 24).",
          "properties": {
            "declared": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "discovered_not_declared": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unclassified": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sources_readable": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sources_unreadable": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "basis_element": {
      "type": "object",
      "required": [
        "claim",
        "kind",
        "origin"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "claim": {
          "type": "string"
        },
        "kind": {
          "$ref": "se.vocabularies.1.json#/$defs/kind"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "description": "Who is making the claim. For declared kind the convention is intent@r<revision> — the revision that asserted it; for derived kind it is the tier that computed it, constrained below."
        },
        "value_as_read": {},
        "ref": {
          "type": "string"
        },
        "consumed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "References to the claims this derivation consumed — how a derived claim is re-checked (DESIGN 24)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "observed"
              }
            }
          },
          "then": {
            "required": [
              "value_as_read",
              "batch",
              "generation",
              "from",
              "evidence_digest",
              "ref"
            ],
            "properties": {
              "batch": {
                "type": "string"
              },
              "generation": {
                "type": "integer"
              },
              "evidence_digest": {
                "type": "string",
                "description": "An equality commitment, not retained evidence: it answers whether the document is still the one this claim was made from, never what the old document contained."
              },
              "canon": {
                "type": "string"
              },
              "from": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "derived"
              }
            }
          },
          "then": {
            "required": [
              "rule",
              "consumed"
            ],
            "properties": {
              "origin": {
                "$ref": "se.vocabularies.1.json#/$defs/tier",
                "description": "Law 4: a derived claim names the tier that computed it (DESIGN 11, 24) — a free string here let a cross-host derivation read as a local reading."
              },
              "rule": {
                "type": "string",
                "description": "rule@version: findings from two versions are comparable only by saying so (DESIGN 25)."
              },
              "observability": {
                "$ref": "se.vocabularies.1.json#/$defs/observability"
              },
              "window": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "complete": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "declared"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "value_as_read",
              "ref"
            ]
          }
        }
      ],
      "description": "unevaluatedProperties rather than additionalProperties, because the kind branches above contribute members; a member no branch evaluated is a claim outside the contract, and an observed element carrying a derived member (or the reverse) is two kinds pretending to be one."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "epistemic": {
            "const": "unknown"
          }
        },
        "required": [
          "epistemic"
        ]
      },
      "else": {
        "properties": {
          "basis": {
            "minItems": 1
          }
        },
        "description": "An unknown answer may carry an empty basis; every other answer cites at least one claim (DESIGN 24)."
      },
      "then": {}
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "estate"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "reach": {
            "required": [
              "consulted",
              "coverage"
            ]
          }
        },
        "description": "No answer of the form all-hosts without its coverage attached (DESIGN 22)."
      }
    },
    {
      "if": {
        "required": [
          "reach"
        ],
        "properties": {
          "reach": {
            "anyOf": [
              {
                "required": [
                  "dark"
                ],
                "properties": {
                  "dark": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "declined"
                ],
                "properties": {
                  "declined": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "unswept"
                ],
                "properties": {
                  "unswept": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "coverage"
                ],
                "properties": {
                  "coverage": {
                    "required": [
                      "sources_unreadable"
                    ],
                    "properties": {
                      "sources_unreadable": {
                        "minItems": 1
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "then": {
        "properties": {
          "epistemic": {
            "enum": [
              "partial",
              "unknown",
              "conflicted"
            ]
          }
        }
      },
      "description": "The epistemic derivation is closed and crude on purpose (DESIGN 25): anything declined, dark, unswept or unreadable means the answer is not complete. This is the monotonicity rule's cheapest checkable corner — a dark host beside a complete answer is ignorance laundered into knowledge."
    }
  ]
}
