{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se.declaration.1.json",
  "title": "System Explorer collector declaration",
  "description": "A collector's static account of what it serves and what it means (DESIGN 19). Same on every host; instance binding is fleet configuration, never declared here. Members and meanings are binding, and every object is closed: six artefacts are generated from this file, so a misspelt member that validates is a sandbox path not granted or a redaction not performed, silently.",
  "type": "object",
  "required": [
    "schema",
    "collector",
    "version",
    "collections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "se.declaration/1"
    },
    "collector": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the deployment must grant. Generated into unit configuration; the collator never reads or passes any of it.",
      "properties": {
        "read_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "credentials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "probe": {
      "type": "string",
      "description": "Prose: what the probe verb establishes."
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/collection"
      }
    }
  },
  "$defs": {
    "collection": {
      "type": "object",
      "required": [
        "name",
        "question",
        "prefix",
        "freshness",
        "perishability",
        "answer",
        "facts"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "description": "The question this collection answers, in the words someone would ask it (DESIGN 15)."
        },
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "freshness": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "description": "The declared honest freshness, e.g. \"60s\". For watched facts this is the reconcile interval (DESIGN 30). The unit is part of the value: a bare \"60\" would be read as seconds by one consumer and milliseconds by another, and staleness verdicts hang off this number."
        },
        "perishability": {
          "$ref": "se.vocabularies.1.json#/$defs/perishability"
        },
        "answer": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The facts that belong on a row (DESIGN 26)."
        },
        "ceiling": {
          "type": "object",
          "additionalProperties": false,
          "description": "A scope error made visible, not a transport limit to paginate around (DESIGN 19).",
          "properties": {
            "records": {
              "type": "integer",
              "minimum": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "discovers": {
          "type": "object",
          "additionalProperties": false,
          "description": "Present where this collection produces estate-membership candidates: its universe and blind spots, stated by the collector that knows its interface (DESIGN 22).",
          "properties": {
            "universe": {
              "type": "string"
            },
            "blind_spots": {
              "type": "string"
            }
          }
        },
        "names": {
          "type": "object",
          "description": "Every name family this collection publishes, by stability class. A join runs on stable only (DESIGN 16, 19).",
          "additionalProperties": {
            "type": "object",
            "required": [
              "class",
              "sentence"
            ],
            "additionalProperties": false,
            "properties": {
              "class": {
                "$ref": "se.vocabularies.1.json#/$defs/name_class"
              },
              "sentence": {
                "type": "string"
              }
            }
          }
        },
        "facts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/fact"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "carries_facts"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "carries_facts": {
                "type": "boolean"
              },
              "discriminator": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The facts that distinguish parallel instances. Absent asserts at-most-singular, and a second instance is an error (DESIGN 13)."
              },
              "inverse_observable": {
                "type": "boolean"
              },
              "facts": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/fact"
                }
              },
              "confirmed_by": {
                "type": "string",
                "description": "The assertion type that confirms this relation from the far end. Required where inverse_observable is true; pairing carries a maximum age spread derived from the tighter collection's declared freshness (DESIGN 19)."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "inverse_observable": {
                      "const": true
                    }
                  },
                  "required": [
                    "inverse_observable"
                  ]
                },
                "then": {
                  "required": [
                    "confirmed_by"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "carries_facts": {
                      "const": true
                    }
                  },
                  "required": [
                    "carries_facts"
                  ]
                },
                "then": {
                  "required": [
                    "facts"
                  ],
                  "properties": {
                    "facts": {
                      "minProperties": 1
                    }
                  }
                },
                "else": {
                  "not": {
                    "required": [
                      "facts"
                    ]
                  }
                },
                "description": "carries_facts is a promise the facts map must keep in both directions: true with no facts declares semantics nobody stated, false with facts ships semantics nobody promised."
              }
            ]
          }
        },
        "redactions": {
          "type": "array",
          "description": "Payload paths whose values are not served verbatim, each with what it reveals. The secret class is withheld entirely; the others are substituted for a public corpus (DESIGN 21).",
          "items": {
            "type": "object",
            "required": [
              "path",
              "discloses"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "discloses": {
                "$ref": "se.vocabularies.1.json#/$defs/discloses"
              }
            }
          }
        },
        "redaction_exemption": {
          "type": "string",
          "minLength": 1,
          "description": "The reviewed statement that this source has no credential surface. Load-bearing prose: carried verbatim, never paraphrased."
        },
        "reference_commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "purpose",
              "argv"
            ],
            "additionalProperties": false,
            "properties": {
              "purpose": {
                "type": "string"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "mutations": {
          "type": "array",
          "description": "Declared and never executed by anything defined in the design (DESIGN 19, 34).",
          "items": {
            "type": "object",
            "required": [
              "name",
              "argv",
              "changes",
              "destructive"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "destructive": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "redactions"
          ]
        },
        {
          "required": [
            "redaction_exemption"
          ]
        }
      ],
      "$comment": "Exactly one, never neither and never both (DESIGN 19): declaring neither is a build failure, and an exemption asserting no credential surface beside a declared redaction list is two rulings contradicting each other in one document."
    },
    "fact": {
      "type": "object",
      "required": [
        "type",
        "temperament",
        "kind",
        "sentence",
        "discloses"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "se.vocabularies.1.json#/$defs/type"
        },
        "unit": {
          "$ref": "se.vocabularies.1.json#/$defs/unit"
        },
        "temperament": {
          "$ref": "se.vocabularies.1.json#/$defs/temperament"
        },
        "kind": {
          "$ref": "se.vocabularies.1.json#/$defs/kind"
        },
        "sentence": {
          "type": "string",
          "minLength": 1,
          "description": "What one of the two consumers renders (DESIGN 28). Never a label."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Closed members, where type is enum."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "A boolean's two display labels (DESIGN 27)."
        },
        "bound": {
          "type": "string",
          "description": "The fact naming this gauge's bound, where one exists (DESIGN 27)."
        },
        "denominator": {
          "type": "string",
          "description": "The fact this percentage is over (DESIGN 27)."
        },
        "rate_companion": {
          "type": "string",
          "description": "The derived windowed gauge published beside this counter (DESIGN 12)."
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "from": {
          "type": "string",
          "description": "Extraction path into the evidence payload; what makes the digest checkable (DESIGN 24)."
        },
        "discloses": {
          "$ref": "se.vocabularies.1.json#/$defs/discloses",
          "description": "Required, with no default: assume nothing and a forgotten serial is published; assume identity and the corpus is scrubbed into uselessness (DESIGN 21)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "values"
            ],
            "properties": {
              "values": {
                "minItems": 1
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "values"
              ]
            }
          },
          "description": "An enum without its members is an open set a renderer must guess at; members on any other type are a vocabulary nothing will ever check a value against."
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {},
          "else": {
            "not": {
              "required": [
                "labels"
              ]
            }
          },
          "description": "labels is a boolean's pair of display words (DESIGN 27); on any other type the pair is dead weight a renderer might wrongly trust."
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "derived"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "derived_from"
            ],
            "properties": {
              "derived_from": {
                "minItems": 1
              }
            }
          },
          "description": "Law 4: a derived fact names the facts it consumed — a derivation with no stated inputs cannot be re-checked."
        },
        {
          "if": {
            "properties": {
              "unit": {
                "const": "percent"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "required": [
              "denominator"
            ]
          },
          "description": "A percentage with no denominator is a number pretending to be an answer (DESIGN 27, 28)."
        }
      ]
    }
  }
}
