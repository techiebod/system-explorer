#!/usr/bin/env python3
"""The live comparator: the reference and the port, one machine, one moment.

PLAN phase 3 named this five times as a venue before it existed, which is how
a reader of the residual ledger could have taken five deferrals for coverage.
It is where DESIGN 19 sends all three replay bounds, where both named residuals
send their truth, and it is gate 3's parity report.

What it does that no other tier can:

  **Parity.** The shipping adapter and the ported collector read the same live
  interfaces at the same moment and their streams are diffed by the corpus's
  own comparator. Replay proves a port reproduces a CAPTURE; this proves it
  reproduces the reference on shapes nobody captured — which is where the
  group-vdev blindness was found, after four layers had agreed it was fine.

  **Clock truth.** Replay pins the clock, so replay can never authenticate a
  clock reading. Here the boot id is read from the machine and compared, and
  every `at` must land inside the CLOCK_BOOTTIME window measured around the
  run. With --twice, a second run must show the stamps advance.

A disagreement is an ADJUDICATION, not a verdict (DESIGN 20). The reference can
lose: it has, three times, on a pool with a spare in it. So this prints both
sides and names the difference rather than declaring a winner.

    se-compare storage                  # parity + clock truth
    se-compare storage network --twice  # and prove the clock moves
    se-compare --json storage           # for a machine, e.g. gate 3's report
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(REPO / "harness"))

from se_harness import live, register, replay  # noqa: E402

# The work list DERIVES from the reference adapters' own collections(),
# through the shared register (R2, 2026-08-21). The hand-written SERVES
# table this replaces was filled in with exactly what the port implemented,
# so both sides were asked only for what the port already had — eighteen
# collections the reference serves were never asked for at all, behind a
# clean report. Now: every reference collection is either compared or
# excluded by a named register entry, the excluded ones appear in the
# report, and a register that disagrees with the tree refuses to run at
# all (register.RegisterViolation) rather than comparing a subset while
# looking exhaustive. The comparator still drives each collector's WHOLE
# compared set in one request, because a multi-collection request is the
# only shape that exercises cross-collection resolution.

REFERENCE = REPO / "harness" / "bin" / "se-live-reference"


MOVING_TEMPERAMENTS = frozenset({"counter", "gauge"})


def moving_facts(collector: str) -> frozenset[str]:
    """Facts this collector declares as readings that do not hold still.

    A `counter` advances and a `gauge` is an instantaneous level, so both
    legitimately differ between the reference run and the port run — this tool
    runs them one after the other against a machine that keeps working, and
    before this every one of them read as a defect. `resources` reported four
    differing rows on EVERY run and not one was real; two consecutive runs gave
    different values and different deltas, which is drift and not logic.

    Read from the collector's own COMMITTED declaration, never from `declare`
    run at the time of comparison. That distinction is the whole safety of it:
    a port asked at run time what to exempt could exempt everything, and the
    comparison would agree with itself. Widening this set is a diff in
    go/cmd/se-collect-<name>/declaration.json that somebody reviews.

    A collector with no committed declaration exempts nothing, which is the
    deny-by-default reading — an unreadable declaration must not silently turn
    into a permissive one.
    """
    path = REPO / "go" / "cmd" / f"se-collect-{collector}" / "declaration.json"
    if not path.is_file():
        return frozenset()
    try:
        declaration = json.loads(path.read_text())
    except ValueError:
        return frozenset()
    names: set[str] = set()
    for collection in declaration.get("collections") or []:
        for name, fact in (collection.get("facts") or {}).items():
            if isinstance(fact, dict) and fact.get("temperament") in MOVING_TEMPERAMENTS:
                names.add(name)
    return frozenset(names)


def port_binary(collector: str) -> Path:
    """The built Go collector. Built, not built-here: the comparator must
    compare what would actually be deployed, and a build step hidden inside a
    measurement is how a stale binary gets measured twice."""
    return REPO / "go" / "bin" / f"se-collect-{collector}"


def is_ported(collector: str) -> bool:
    """Whether a Go collector exists to compare the reference against.

    NOT PORTED is a third state beside clean and failed, and it has to be its
    own state for the report to be legible: the work list derives from the
    reference adapters, so no collector can be quietly left out — but a
    checkout without built binaries is a real venue this tool runs in.
    Collapsing "no binary here" into a failure would make the report read as
    twenty defects on any such machine, and collapsing it into a pass would
    be the far worse direction: silence over a collector nothing compared.
    """
    return port_binary(collector).exists()


def run_one(argv: list[str], collector: str, collections: list[str],
            env_extra: dict[str, str] | None = None) -> tuple[list[dict], live.Window, str]:
    """One collector process, with the clock read either side of it."""
    import os

    request = "collect " + " ".join(f"{c}:{i + 1}" for i, c in enumerate(collections))
    env = dict(os.environ)
    env.pop("SE_REPLAY_DIR", None)  # the live tools refuse it; be explicit
    if env_extra:
        env.update(env_extra)

    boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    before = time.clock_gettime(time.CLOCK_BOOTTIME)
    started = time.monotonic()
    proc = subprocess.run(argv, input=request + "\n", capture_output=True,
                          text=True, env=env)
    wall_ms = (time.monotonic() - started) * 1000
    after = time.clock_gettime(time.CLOCK_BOOTTIME)

    if proc.returncode != 0:
        # "I could not run" is a real outcome and one side of a real
        # comparison, so it is REPORTED rather than fatal. The first version
        # of this tool raised here, and on a host carrying OpenZFS 2.2.2 —
        # where `zpool status -j` does not exist, the shipping adapter throws,
        # and the port declines `unsupported` correctly — it killed the run
        # instead of printing the most interesting result the comparator has
        # produced: the two implementations differ about what this host is.
        # A comparator that dies on the asymmetry it exists to find is a
        # comparator with a blind spot exactly where it matters.
        raise CouldNotRun(argv, proc.returncode, proc.stderr)
    return (
        replay.parse_stream(proc.stdout),
        live.Window(boot_id=boot, before=before, after=after, wall_ms=wall_ms),
        proc.stderr,
    )


class CouldNotRun(Exception):
    """One side of the comparison did not produce a reading at all."""

    def __init__(self, argv: list[str], code: int, stderr: str) -> None:
        self.argv, self.code, self.stderr = argv, code, stderr
        super().__init__(f"{argv[-1]} exited {code}")


# Divergences a ruling put there, per collector: the facts the reference emits
# and the port is not asked to, with the ruling that says so.
#
# Removed from the REFERENCE before the diff and never from the port, which is
# the whole of what keeps this from being a hole. If both sides were stripped,
# a port that emitted a delta fact — wrongly, since the ruling puts them out of
# its scope — would be invisible; stripping one side means the port publishing
# any of them is itself reported, under port_emitted_accepted. And a divergence
# on any fact NOT listed here still fails, which is the property the acceptance
# must not widen into.
# The OTHER direction, and the comparator could not express it at all
# until 2026-08-23: facts the PORT emits and the reference does not.
#
# The asymmetry is the same one inverted, and it is what keeps this from
# becoming a hole. Removed from the PORT before the diff and never from
# the reference, so a REFERENCE that started emitting a listed fact is
# itself reported, under reference_emitted_accepted. A divergence on any
# fact not listed here still fails.
#
# Empty, deliberately. The first case is system/identity — the port emits
# Hostname, OsId, OsPrettyName and OsVersionId, which the reference does
# not — and whether a port's scope MAY exceed the reference's is what §20
# reserves for the owner. The mechanism exists so that ruling is one
# entry rather than a change to this file; it is not a licence to widen
# scope by editing a table.
PORT_ONLY_DIVERGENCES: dict[str, dict] = {}

ACCEPTED_DIVERGENCES = {
    "nix": {
        "facts": frozenset({
            "ComparedWithGeneration", "DeltaCounts", "DeltaFromPrevious",
            "DeltaFromPreviousPartial", "DeltaFromPreviousUnobservable",
        }),
        "ruling": (
            "what CHANGED between two generations left the rewrite's scope on "
            "2026-08-19 and becomes a plugin once a plugin surface exists "
            "(DESIGN, adjudication queue). The shipping adapter keeps emitting "
            "these five until the cut because it is what the estate runs; the "
            "port declares and emits none of them, and must agree on every "
            "other fact in the collection"
        ),
    },
}


def _without(record: dict, facts: frozenset) -> dict:
    """One record with the accepted facts removed from its facts mapping."""
    if not isinstance(record.get("facts"), dict):
        return record
    kept = {k: v for k, v in record["facts"].items() if k not in facts}
    if len(kept) == len(record["facts"]):
        return record
    return {**record, "facts": kept}


def compare(collector: str, work: dict, twice: bool) -> dict:
    collections = work["compare"]
    result: dict = {"collector": collector, "collections": collections}
    if work["excluded"]:
        # Every reference collection this run does NOT drive, with the
        # register entry that says why. Reported on every run, because an
        # exclusion that is only visible in a source file is an exclusion
        # a reader of the report cannot see.
        result["not_compared"] = dict(work["excluded"])
    if not collections:
        result["nothing_to_compare"] = (
            "every collection this adapter serves is excluded by the "
            "register; the entries above say why"
        )
        result["clean"] = True
        return result

    if not is_ported(collector):
        result["not_ported"] = (
            f"no {port_binary(collector).name} — the seam can replay this "
            "collector and nothing has been written to compare against yet"
        )
        result["clean"] = True  # nothing was compared, and nothing failed
        return result

    try:
        reference, ref_window, ref_stderr = run_one(
            [sys.executable, str(REFERENCE)], collector, collections,
            {"SE_REFERENCE_COLLECTOR": collector},
        )
    except CouldNotRun as exc:
        return _one_sided(result, "reference", exc, collector, collections)
    try:
        port, port_window, port_stderr = run_one(
            [str(port_binary(collector))], collector, collections,
        )
    except CouldNotRun as exc:
        return _one_sided(result, "port", exc, collector, collections)

    # The corpus's own comparator, so parity here means exactly what replay
    # equivalence means: records compared by identity, run-varying members
    # governed by their named rules rather than by bytes (DESIGN 19).
    #
    # With one addition replay does not need and this tier cannot do without:
    # the facts the collector declares as counters and gauges are compared for
    # presence and type but not for value, because nothing here can freeze the
    # machine between the two runs.
    moving = moving_facts(collector)
    result["moving_facts"] = sorted(moving)
    # An ACCEPTED divergence is removed from the reference, and only from the
    # reference. Gate 3's clause is "clean or its diffs are named and
    # accepted", and a comparator that could not express the second half would
    # report a ruled scope decision as a defect on every future run — which is
    # how a report stops being read. See ACCEPTED_DIVERGENCES for why removing
    # one side rather than both is what keeps this discriminating.
    accepted = ACCEPTED_DIVERGENCES.get(collector)
    if accepted:
        result["accepted_divergence"] = {
            "facts": sorted(accepted["facts"]), "ruling": accepted["ruling"]}
        reference = [_without(record, accepted["facts"]) for record in reference]
        result["port_emitted_accepted"] = sorted({
            name
            for record in port
            for name in (record.get("facts") or {})
            if name in accepted["facts"]
        })
    port_only = PORT_ONLY_DIVERGENCES.get(collector)
    if port_only:
        result["port_only_divergence"] = {
            "facts": sorted(port_only["facts"]), "ruling": port_only["ruling"]}
        port = [_without(record, port_only["facts"]) for record in port]
        result["reference_emitted_accepted"] = sorted({
            name
            for record in reference
            for name in (record.get("facts") or {})
            if name in port_only["facts"]
        })
    result["differences"] = replay.diff(reference, port, moving)
    # The order layer, which diff() is deliberately blind to: applied order
    # is preserved end to end (DESIGN 19, ruled 2026-08-21), so two streams
    # that agree on every row and disagree on the sequence are two different
    # pages. Reported only where the rows themselves agree — a membership
    # disagreement is already in `differences` and must not be spelled twice.
    result["order"] = replay.order_differences(reference, port)
    # The rules layer, stated rather than compared, because it cannot be
    # compared here and saying nothing would report coverage this tool does
    # not have: opinions never reach the collect stream — the collator
    # evaluates them from the declaration's rule tables — and the reference's
    # opinions are code, not data. What CAN be read is whether the port
    # declares any tables at all; parity of judgement is register row 8,
    # owed R3c/R3d.
    declared = register.ported_collections().get(collector, {})
    result["rules"] = {
        "port_declares": {
            name: len(c.get("rules") or []) for name, c in declared.items()
            if name in collections},
        "coverage": (
            "declared rule tables counted only; opinions are collator-"
            "evaluated and never on this wire, and the reference's judgement "
            "is code — parity of judgement is register row 8"),
    }

    # Clock truth, per side. The REFERENCE is judged too — it is the thing
    # every corpus pair is generated from, and a reference that had stopped
    # reading the clock would teach every port to do the same.
    result["reference_clock"] = live.authenticate(reference, ref_window)
    result["port_clock"] = live.authenticate(port, port_window)

    # The port is a shipping artefact, so it is held to the stream laws too.
    # The reference is not: it emits no declaration document, and check_stream
    # asks for things only a declared collector can promise.
    result["port_stream"] = replay.check_stream(
        port, {c: i + 1 for i, c in enumerate(collections)}
    )

    result["boot_id"] = ref_window.boot_id
    result["counts"] = {
        "reference": _counts(reference),
        "port": _counts(port),
    }
    for name, text in (("reference", ref_stderr), ("port", port_stderr)):
        if text.strip():
            result.setdefault("stderr", {})[name] = text[:2000]

    if twice:
        # Far enough apart that a real clock has visibly moved, and short
        # enough that nobody waits. The point is not the duration — it is that
        # a cached or derived stamp cannot follow.
        time.sleep(1.5)
        second_ref, _, _ = run_one(
            [sys.executable, str(REFERENCE)], collector, collections,
            {"SE_REFERENCE_COLLECTOR": collector},
        )
        second_port, second_window, _ = run_one(
            [str(port_binary(collector))], collector, collections,
        )
        result["reference_advanced"] = live.advanced(reference, second_ref)
        result["port_advanced"] = live.advanced(port, second_port)
        # Two runs on one boot: the boot id must NOT have changed, and saying
        # so is what keeps the cross-boot claim from being quietly assumed.
        result["cross_boot"] = (
            "untested on one boot — run either side of a reboot and compare "
            f"boot_id, which is {ref_window.boot_id!r} here"
            if second_window.boot_id == ref_window.boot_id
            else f"the machine rebooted mid-run ({ref_window.boot_id} → "
                 f"{second_window.boot_id}); rerun"
        )

    result["clean"] = not any(
        result.get(key) for key in (
            "differences", "order", "reference_clock", "port_clock",
            "port_stream", "reference_advanced", "port_advanced",
        )
    )
    return result


def _one_sided(result: dict, who: str, exc: CouldNotRun,
               collector: str, collections: list[str]) -> dict:
    """One side produced no reading. Report what the OTHER side said anyway.

    This is an adjudication, not a verdict (DESIGN 20): the reference can
    lose, and "the shipping product cannot read this host and the port can"
    is a finding worth more than either stream alone. So the surviving side
    is still run and shown, and the failure is named with its exit status and
    its stderr rather than reduced to a crash.
    """
    other = "port" if who == "reference" else "reference"
    result["could_not_run"] = {
        "side": who,
        "exit": exc.code,
        "stderr": exc.stderr.strip()[:1500],
    }
    try:
        argv = ([sys.executable, str(REFERENCE)] if other == "reference"
                else [str(port_binary(collector))])
        env = {"SE_REFERENCE_COLLECTOR": collector} if other == "reference" else None
        records, _, _ = run_one(argv, collector, collections, env)
        result["surviving_side"] = {other: _counts(records)}
        result["surviving_statement"] = [
            f"{r.get('record')} {r.get('collection')}: {r.get('reason')}"
            for r in records if r.get("record") == "decline"
        ] or [f"{other} committed {sum(1 for r in records if r.get('record') == 'object')} objects"]
    except CouldNotRun as also:
        result["surviving_side"] = {other: f"also could not run (exit {also.code})"}
    result["clean"] = False
    return result


def _counts(records: list[dict]) -> dict[str, int]:
    out: dict[str, int] = {}
    for record in records:
        kind = str(record.get("record"))
        out[kind] = out.get(kind, 0) + 1
    return out


def render(result: dict) -> str:
    lines = [f"── {result['collector']} ({', '.join(result['collections'])})"]
    for collection, reason in sorted(result.get("not_compared", {}).items()):
        lines.append(f"  · not compared: {collection} — {reason}")
    if "nothing_to_compare" in result:
        lines.append(f"  · {result['nothing_to_compare']}")
        return "\n".join(lines)
    if "not_ported" in result:
        lines.append(f"  · not ported: {result['not_ported']}")
        return "\n".join(lines)
    if "could_not_run" in result:
        failed = result["could_not_run"]
        lines.append(f"  ✗ the {failed['side']} could not run (exit {failed['exit']})")
        for text in failed["stderr"].splitlines()[-3:]:
            lines.append(f"      {text[:160]}")
        for side, what in result.get("surviving_side", {}).items():
            lines.append(f"  · the {side} DID read this host: {what}")
        for statement in result.get("surviving_statement", []):
            lines.append(f"      {statement}")
        lines.append("  · adjudication: the two implementations disagree about "
                     "what this host is, which is a finding and not a crash")
        return "\n".join(lines)
    ref, port = result["counts"]["reference"], result["counts"]["port"]
    for kind in sorted(set(ref) | set(port)):
        mark = " " if ref.get(kind) == port.get(kind) else "!"
        lines.append(f"  {mark} {kind:<20} reference {ref.get(kind, 0):>5}"
                     f"   port {port.get(kind, 0):>5}")
    accepted = result.get("accepted_divergence")
    if accepted:
        lines.append("  · accepted divergence: "
                     + ", ".join(accepted["facts"]))
        lines.append(f"      {accepted['ruling']}")
    for label, key in (
        ("port stayed out of the accepted divergence", "port_emitted_accepted"),
        ("parity", "differences"),
        ("applied order", "order"),
        ("reference clock", "reference_clock"),
        ("port clock", "port_clock"),
        ("port stream", "port_stream"),
        ("reference advanced", "reference_advanced"),
        ("port advanced", "port_advanced"),
    ):
        problems = result.get(key)
        if problems is None:
            continue
        if not problems:
            lines.append(f"  ✓ {label}")
            continue
        lines.append(f"  ✗ {label}: {len(problems)}")
        for problem in problems[:20]:
            lines.append(f"      - {problem}")
        if len(problems) > 20:
            lines.append(f"      … {len(problems) - 20} more")
    if "rules" in result:
        declared = result["rules"]["port_declares"]
        lines.append("  · rules: " + (
            ", ".join(f"{name} declares {n}" for name, n in sorted(declared.items())
                      if n)
            or "no rule tables declared") + f" — {result['rules']['coverage']}")
    if "cross_boot" in result:
        lines.append(f"  · cross-boot: {result['cross_boot']}")
    if "stderr" in result:
        for who, text in result["stderr"].items():
            lines.append(f"  · {who} stderr: {text.strip().splitlines()[0][:160]}")
    return "\n".join(lines)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("collectors", nargs="*", default=None,
                        help="which to compare; default every collector the "
                             "reference adapters serve")
    parser.add_argument("--twice", action="store_true",
                        help="run each twice and prove the stamps advance")
    parser.add_argument("--json", action="store_true", help="machine-readable report")
    args = parser.parse_args()

    # Derived, and derived FIRST: a register that disagrees with the tree —
    # an unregistered gap, a stale owed entry, a port collection the
    # reference never served — refuses the whole run before a single
    # collector is compared. A comparator that ran anyway would report
    # parity about a subset while looking exhaustive, which is the exact
    # shape this derivation replaced.
    try:
        work = register.comparator_work()
    except register.RegisterViolation as exc:
        raise SystemExit(f"refusing to compare: {exc}") from exc

    chosen = args.collectors or sorted(work)
    unknown = [c for c in chosen if c not in work]
    if unknown:
        raise SystemExit(f"unknown collector(s) {unknown}; known: {sorted(work)}")

    results = [compare(collector, work[collector], args.twice)
               for collector in chosen]
    if args.json:
        print(json.dumps(results, indent=2, sort_keys=True))
    else:
        for result in results:
            print(render(result))

    # Non-zero when anything disagreed: this is a gate check, and a report
    # nobody's CI can fail on is a report.
    raise SystemExit(0 if all(r["clean"] for r in results) else 1)


if __name__ == "__main__":
    main()
