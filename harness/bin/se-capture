#!/usr/bin/env python3
"""Generate the expected half of a corpus pair from the reference implementation.

The plan's rule 4: the shipping agent is the reference implementation, so what
it emits for a set of payloads is what a ported collector must reproduce. This
writes that down.

Generated is not the same as reviewed. This tool prints the diff against what
is already committed and refuses to overwrite unless told to, because a
reference answer nobody read is a reference answer nobody can trust — and a
corpus that regenerates itself silently would ratify a regression the first
time one landed.

    se-capture corpus/storage/healthy            # show what would change
    se-capture --write corpus/storage/healthy    # write it, after reading
"""

from __future__ import annotations

import argparse
import difflib
import functools
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent.parent
REFERENCE = REPO / "harness" / "bin" / "se-reference-collector"

sys.path.insert(0, str(REPO / "harness"))

from se_harness.replay import issue_generations  # noqa: E402


def ported_collectors() -> dict[str, str]:
    """conformance/conftest.py's GO_COLLECTORS, read without importing it.

    The retirement table lives there because two test modules resolve through
    it, and this tool must give the SAME answer or the corpus is regenerated
    by one reference and judged against another. By AST rather than by import
    because conftest pulls in pytest and the adapters; reading the product's
    own table is the pattern test_corpus_replay already uses for the SEAM.

    Without this, `regenerable: true` was a claim no tool could honour:
    se-capture hardcoded the Python shim, which has never heard of a ported
    collector, so corpus/system/healthy shipped declaring itself re-stageable
    while nothing committed could re-stage it — and the coverage report
    repeated the claim.
    """
    import ast

    source = (REPO / "conformance" / "conftest.py").read_text()
    for node in ast.walk(ast.parse(source)):
        if isinstance(node, ast.Assign) and any(
            isinstance(t, ast.Name) and t.id == "GO_COLLECTORS" for t in node.targets
        ):
            return ast.literal_eval(node.value)
    raise SystemExit("no GO_COLLECTORS table in conformance/conftest.py")


@functools.cache
def reference_for(collector: str) -> list[str]:
    """The command that IS the reference for this collector.

    Exactly conftest.reference_command's rule: the Python shim until a
    collector ports, its own binary after — "the shim retires collector by
    collector, and this table is where a retirement lands". A ported
    collector regenerating from the shim would ratify the shim's answer over
    the artefact that actually ships, and for a collector with no Python
    adapter at all the shim cannot answer at all.
    """
    package = ported_collectors().get(collector)
    if package is None:
        return [sys.executable, str(REFERENCE)]

    go = shutil.which("go") or (
        "/opt/homebrew/bin/go"
        if Path("/opt/homebrew/bin/go").exists()
        else None
    )
    if go is None:
        raise SystemExit(
            f"{collector} is a ported collector and no Go toolchain is on "
            "PATH or at /opt/homebrew/bin/go, so its reference cannot be built"
        )
    out = Path(tempfile.mkdtemp(prefix="se-capture-build-")) / f"se-collect-{collector}"
    build = subprocess.run(
        [go, "build", "-o", str(out), package],
        cwd=REPO / "go",
        capture_output=True,
        text=True,
        timeout=300,
    )
    if build.returncode != 0:
        print(build.stderr, file=sys.stderr)
        raise SystemExit(f"go build {package} exited {build.returncode}")
    return [str(out)]


def capture(variant: Path) -> str:
    meta = json.loads((variant / "meta.json").read_text())
    collections = meta.get("collections") or []
    env = dict(os.environ)
    env["SE_REPLAY_DIR"] = str(variant / "payloads")
    env["SE_REFERENCE_COLLECTOR"] = meta["collector"]
    if meta.get("captured"):
        env["SE_REPLAY_NOW"] = meta["captured"]

    # The request line is the new wire (DESIGN 18): each token carries the
    # generation the harness-as-collator issues, from the same deterministic
    # rule the replay tests use — so a captured pair and a replayed one are
    # judged under identical issuance, and a bare-name token (the OLD wire)
    # is exit 2 rather than a second dialect. The seed is the variant's
    # identity, spelled exactly as Variant.name spells it, because the
    # issuance is per-variant now: a fixed base was the constant the echo
    # guard could never catch.
    issued = issue_generations(collections, seed=f"{meta['collector']}/{variant.name}")
    tokens = " ".join(f"{name}:{gen}" for name, gen in sorted(issued.items()))
    proc = subprocess.run(
        reference_for(meta["collector"]),
        input=f"collect {tokens}\n",
        capture_output=True,
        text=True,
        env=env,
        timeout=120,
    )
    if proc.returncode != 0:
        print(proc.stderr, file=sys.stderr)
        raise SystemExit(f"{variant}: reference collector exited {proc.returncode}")

    canaries = meta.get("canaries") or []
    for canary in canaries:
        if canary in proc.stdout:
            raise SystemExit(
                f"{variant}: planted canary {canary!r} appears in the captured "
                "stream — capturing a leak into the corpus would make the "
                "canary check ratify it forever"
            )
    return proc.stdout


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("variants", nargs="+", type=Path)
    parser.add_argument(
        "--write", action="store_true", help="write after you have read the diff"
    )
    args = parser.parse_args()

    changed = 0
    for variant in args.variants:
        produced = capture(variant)
        target = variant / "expected.jsonl"
        current = target.read_text() if target.exists() else ""
        if produced == current:
            print(f"{variant}: unchanged")
            continue
        changed += 1
        diff = difflib.unified_diff(
            current.splitlines(True),
            produced.splitlines(True),
            fromfile=f"{target} (committed)",
            tofile=f"{target} (reference)",
            n=1,
        )
        sys.stdout.writelines(diff)
        if args.write:
            target.write_text(produced)
            print(f"{variant}: written")
        else:
            print(f"{variant}: would change — rerun with --write once read")

    if changed and not args.write:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
