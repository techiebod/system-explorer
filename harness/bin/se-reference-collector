#!/usr/bin/env python3
"""The reference implementation, wearing a collector's face.

Rule 4 of the plan: the shipping agent is the reference implementation, and a
ported collector earns its place by reproducing what this emits for the same
payloads. So this speaks the collector contract of DESIGN 18 — a request line
on stdin, an NDJSON stream on stdout — over the shipping adapters, and reads
its native documents from SE_REPLAY_DIR rather than from the live interface.

It exists to make the corpus real before a single Go binary does, so the
harness that judges those binaries is itself exercised and trusted first.

This is a development tool. It retires when the last collector is ported.
"""

from __future__ import annotations

import asyncio
import json
import os
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(REPO / "src"))
sys.path.insert(0, str(REPO / "harness"))

from se_harness.emission import Emitter, parse_generations  # noqa: E402


def fail(message: str) -> None:
    """Non-zero means 'I could not run' — never a decline (DESIGN 18)."""
    print(message, file=sys.stderr)
    raise SystemExit(2)


def pin_clock(when: str) -> None:
    """Freeze wall-clock time to the moment the corpus was captured.

    Some facts are derived at acquisition against *now* — a scrub's age in
    days, a snapshot's age in seconds. Replayed against a live clock they
    change every day, so a corpus pair would rot on the shelf and the harness
    would teach a reader to ignore it.

    Called at MODULE scope, before the adapters are imported: a module that
    binds ``from time import time`` at import scope would otherwise keep the
    real callable and escape the pin silently.
    """
    import datetime as _dt
    import time as _time

    moment = _dt.datetime.fromisoformat(when.replace("Z", "+00:00"))
    epoch = moment.timestamp()
    _time.time = lambda: epoch  # noqa: E731

    class _Frozen(_dt.datetime):
        @classmethod
        def now(cls, tz=None):
            return moment.astimezone(tz) if tz else moment.replace(tzinfo=None)

        @classmethod
        def utcnow(cls):
            return moment.replace(tzinfo=None)

    _dt.datetime = _Frozen


if os.environ.get("SE_REPLAY_NOW"):
    pin_clock(os.environ["SE_REPLAY_NOW"])

from system_explorer.agent.adapters import network, storage  # noqa: E402

# Which module-level acquisition each collector redirects, and what payload
# file feeds it. This table is the whole of the replay seam for the reference
# implementation; a Go collector implements the same redirect natively.
#
# `acquisitions` are the interface documents — all of them missing means the
# interface was absent and the batch declines. `auxiliary` are acquisitions
# that qualify the interface without being it (device alias links): a missing
# one pins to its stated default so the adapter can say could-not-read,
# rather than counting toward absence.
# `collections` is the closed set this shim can replay: the collections
# derived from the stubbed acquisitions and no others. It is load-bearing
# twice. It is the SEAM's safety bound — `collect links:5` is a legal request
# line, and without this list `acquire("links")` would run `ip -j` against the
# machine REPLAYING the corpus, the same seam escape that once put a
# replaying workstation's filesystem into committed facts. And it is the
# authority the corpus coverage check reads: a collection served here and
# captured by no variant is a hole, and until nft-rules was captured it was
# one nothing could see, because nothing enumerated collections at all.
SEAM = {
    "storage": {
        "module": storage,
        "adapter": storage.Adapter,
        "interface": "zpool",
        "collections": ["pools"],
        "acquisitions": {"_zpool_status": "status", "_zpool_list": "list"},
        "auxiliary": {"_devlinks": ("devlinks", None)},
        # The capability probe asks the host whether zpool exists. Under
        # replay the payload is the evidence that it did, on the machine the
        # capture came from — so the probe is satisfied by the corpus rather
        # than re-run against the wrong host.
        "instance": {"_zfs": True},
    },
    "network": {
        "module": network,
        "adapter": network.Adapter,
        "interface": "nft",
        # One payload, two collections: nft-chains and nft-rules are both
        # derived from the same `nft -j list ruleset` document, and a request
        # naming both replays them from this single redirect, deterministically
        # — test_reference_honesty drives that request and holds each commit
        # to its own issued generation. corpus/network/rules is the committed
        # pair, which is what closed the named residual that stood here while
        # the round-a5 chains-only fixtures were the only subjects.
        "collections": ["nft-chains", "nft-rules"],
        "acquisitions": {"_nft_json": "nft"},
        "instance": {},
    },
}


def load_payloads(directory: Path) -> dict[str, object]:
    return {p.stem: json.loads(p.read_text()) for p in sorted(directory.glob("*.json"))}


def uncaptured(payload_name: str):
    """An acquisition whose payload the variant did not capture.

    It must never fall back to the live interface of the machine REPLAYING
    the corpus — that is exactly the seam escape that put the replaying
    workstation's filesystem into committed facts — so it raises, and the
    adapter's own degradation decides what that costs (zpool list is
    enrichment and degrades to unobservable capacity facts; zpool status is
    the fact source and cannot).
    """

    def read(*_args, **_kwargs):
        raise RuntimeError(f"payload {payload_name!r} was not captured in this variant")

    return read


def run(collector: str, generations: dict[str, int], payload_dir: Path) -> None:
    spec = SEAM.get(collector)
    if spec is None:
        fail(f"unknown collector {collector!r}; known: {sorted(SEAM)}")

    # Refused before anything is acquired, and refused as "I could not run"
    # rather than declined: a decline states something about a machine, and
    # this shim observed no machine at all for a collection whose acquisition
    # it never stubbed. The live adapter would happily answer — which is the
    # danger, since the interface it would read belongs to whichever host is
    # REPLAYING the corpus, not to the one captured.
    unservable = [c for c in generations if c not in spec["collections"]]
    if unservable:
        fail(
            f"{collector}: cannot replay {unservable} — this seam stubs only "
            f"{spec['collections']}, and acquiring anything else would read "
            "the live interface of the machine replaying the corpus"
        )

    payloads = load_payloads(payload_dir)
    module = spec["module"]

    # Decline only when EVERY interface acquisition is missing. A storage
    # capture with status but no list is a partially-readable interface, and
    # the shipping adapter degrades through it on purpose — declining there
    # would make this a second implementation rather than the reference one,
    # in the direction that destroys data, since an absent decline retires
    # objects.
    present = [n for n in spec["acquisitions"].values() if n in payloads]
    absent = not present

    for attribute, payload_name in spec["acquisitions"].items():
        if payload_name in payloads:
            value = payloads[payload_name]
            setattr(module, attribute, lambda _v=value, *a, **k: _v)
        else:
            setattr(module, attribute, uncaptured(payload_name))
    for attribute, (payload_name, default) in spec.get("auxiliary", {}).items():
        value = payloads.get(payload_name, default)
        setattr(module, attribute, lambda _v=value, *a, **k: _v)

    out = Emitter(
        sys.stdout,
        generations,
        {
            "request": "replay",
            "batch": "replay",
            "declaration": "sha256:replay",
            # A replay has no boot, so this is a fixed v4-shaped id, "5e" up
            # front so no reader mistakes it for a capture. The old "replay"
            # stub is what the shape rule now refuses; that the constant
            # itself still passes is DESIGN 19's named deferral, and the
            # venue that closes it is the live comparator — which reads the
            # machine's real boot id and compares, so a constant valid id
            # fails there in a single run rather than needing a cross-boot
            # capture nobody has taken.
            "boot_id": "5e000000-0000-4000-8000-000000000001",
            "timens": 0,
            "instance": None,
        },
        # `at` is a monotonic reading in production; under replay it is the
        # reference constant 1.0 + 0.001*i in emission order — finite,
        # positive, boot-scale and strictly advancing, so the structural rule
        # that governs it is exercised by the corpus instead of being
        # satisfied by a hardcoded zero. Whether a LIVE reading is a real
        # clock reading is the comparator's to say, not this one's.
        stamp=lambda i: round(1.0 + 0.001 * i, 3),
        # The reference's deterministic stand-ins: run-varying members are
        # rule-governed rather than byte-compared (DESIGN 19), and the rule
        # wants a batch that ran to report positive measured cost.
        costs=lambda: (0.5, 1.0),
    )
    out.begin()

    if absent:
        # absent is authoritative-empty (DESIGN 19): it must be able to retire
        # objects a previous batch published, so it declines AND commits zero.
        for collection in generations:
            out.decline(collection, "absent", f"no {spec['interface']} on this host")
            out.commit(collection, objects=0, assertions=0, unobservable=0)
        out.end()
        return

    adapter = spec["adapter"]()
    for attribute, value in spec.get("instance", {}).items():
        setattr(adapter, attribute, value)

    for collection in generations:
        try:
            items = asyncio.run(adapter.acquire(collection))
        except Exception as exc:  # a real inability to run, not a decline
            fail(
                f"{collector}/{collection}: acquisition raised "
                f"{type(exc).__name__}: {exc}"
            )
        out.commit(collection, *out.items(collection, items))

    out.end()


def main() -> None:
    payload_dir = os.environ.get("SE_REPLAY_DIR")
    if not payload_dir:
        fail("SE_REPLAY_DIR is unset: this shim only replays, it never reads a host")
    directory = Path(payload_dir)
    if not directory.is_dir():
        fail(f"SE_REPLAY_DIR={payload_dir} is not a directory")

    line = sys.stdin.readline().strip()
    if not line:
        fail("no request line on stdin")
    parts = line.split()
    if parts[0] != "collect":
        fail(f"this shim serves collect only, not {parts[0]!r}")

    collector = os.environ.get("SE_REFERENCE_COLLECTOR")
    if not collector:
        fail("SE_REFERENCE_COLLECTOR must name which adapter to replay")

    run(collector, parse_generations(parts[1:], fail), directory)


if __name__ == "__main__":
    main()
