#!/usr/bin/env python3
"""The reference implementation, wearing a collector's face.

Rule 4 of the plan: the shipping agent is the reference implementation, and a
ported collector earns its place by reproducing what this emits for the same
payloads. So this speaks the collector contract of DESIGN 18 — a request line
on stdin, an NDJSON stream on stdout — over the shipping adapters, and reads
its native documents from SE_REPLAY_DIR rather than from the live interface.

It exists to make the corpus real before a single Go binary does, so the
harness that judges those binaries is itself exercised and trusted first.

This is a development tool. It retires when the last collector is ported.
"""

from __future__ import annotations

import asyncio
import json
import os
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(REPO / "src"))
sys.path.insert(0, str(REPO / "harness"))

from se_harness.emission import Emitter, materialise, parse_generations  # noqa: E402


def fail(message: str) -> None:
    """Non-zero means 'I could not run' — never a decline (DESIGN 18)."""
    print(message, file=sys.stderr)
    raise SystemExit(2)


def pin_clock(when: str) -> None:
    """Freeze wall-clock time to the moment the corpus was captured.

    Some facts are derived at acquisition against *now* — a scrub's age in
    days, a snapshot's age in seconds. Replayed against a live clock they
    change every day, so a corpus pair would rot on the shelf and the harness
    would teach a reader to ignore it.

    Called at MODULE scope, before the adapters are imported: a module that
    binds ``from time import time`` at import scope would otherwise keep the
    real callable and escape the pin silently.
    """
    import datetime as _dt
    import time as _time

    moment = _dt.datetime.fromisoformat(when.replace("Z", "+00:00"))
    epoch = moment.timestamp()
    _time.time = lambda: epoch  # noqa: E731

    class _Frozen(_dt.datetime):
        @classmethod
        def now(cls, tz=None):
            return moment.astimezone(tz) if tz else moment.replace(tzinfo=None)

        @classmethod
        def utcnow(cls):
            return moment.replace(tzinfo=None)

    _dt.datetime = _Frozen


if os.environ.get("SE_REPLAY_NOW"):
    pin_clock(os.environ["SE_REPLAY_NOW"])

# The one third-party import this shim makes, and it is here for a reason the
# fleet seam explains in full: an HTTP interface answers some requests with a
# STATUS and no document, and the adapter branches on that status through
# httpx's own exception type. Raising anything else would make the shim's
# choice of exception the thing under test.
import httpx  # noqa: E402

from system_explorer.agent import envelope as env  # noqa: E402
# units acquires through the shared D-Bus singleton rather than a
# module function, so the seam needs the interface constant it keys on.
from system_explorer.agent.sysbus import PROPERTIES  # noqa: E402
from system_explorer.agent.adapters import (  # noqa: E402
    bazarr, docker, downloaders, hardware, kea, logs, network, nix, packages,
    paperless, plex, protection, resources, servarr, storage, traefik,
    unbound, units, vms,
)
# nix is the one collector whose walk lives in a module OTHER than its
# adapter: agent/nixos.py is the complete inventory of what this agent reads
# that exists only on NixOS, shared with `system` and `packages`, and putting
# a copy of it in the adapter to satisfy the seam would make the ownership
# arbitrary and the sharing invisible. So the seam's `module` and `adapter`
# come from different files here, which they have always been free to.
from system_explorer.agent import nixos  # noqa: E402

# Which module-level acquisition each collector redirects, and what payload
# file feeds it. This table is the whole of the replay seam for the reference
# implementation; a Go collector implements the same redirect natively.
#
# `acquisitions` are the interface documents — all of them missing means the
# interface was absent and the batch declines. `auxiliary` are acquisitions
# that qualify the interface without being it (device alias links): a missing
# one pins to its stated default so the adapter can say could-not-read,
# rather than counting toward absence. `path_acquisitions` are the tree seam:
# one document per primitive, keyed the way a filesystem is, for an interface
# that answers a WALK rather than a request.
# `collections` is the closed set this shim can replay: the collections
# derived from the stubbed acquisitions and no others. It is load-bearing
# twice. It is the SEAM's safety bound — `collect links:5` is a legal request
# line, and without this list `acquire("links")` would run `ip -j` against the
# machine REPLAYING the corpus, the same seam escape that once put a
# replaying workstation's filesystem into committed facts. And it is the
# authority the corpus coverage check reads: a collection served here and
# captured by no variant is a hole, and until nft-rules was captured it was
# one nothing could see, because nothing enumerated collections at all.
SEAM = {
    "storage": {
        "module": storage,
        "adapter": storage.Adapter,
        "interface": "zpool",
        "collections": ["pools", "block-devices", "mounts"],
        "acquisitions": {"_zpool_status": "status", "_zpool_list": "list",
                         "_lsblk": "lsblk", "_findmnt": "findmnt"},
        "auxiliary": {"_devlinks": ("devlinks", None)},
        # The capability probe asks the host whether zpool exists. Under
        # replay the payload is the evidence that it did, on the machine the
        # capture came from — so the probe is satisfied by the corpus rather
        # than re-run against the wrong host.
        "instance": {"_zfs": True},
    },
    # ── drop-ins: one or two zero-argument module-level readers ──────────
    "vms": {
        "module": vms,
        "adapter": vms.Adapter,
        "interface": "libvirt",
        "collections": ["domains"],
        # The cleanest seam of the seventeen: one function that opens the
        # read-only libvirt connection, walks every domain, and returns plain
        # dicts with the XML as a string.
        "acquisitions": {"_domains_raw": "domains"},
        "instance": {},
    },
    "packages": {
        "module": packages,
        "adapter": packages.Adapter,
        "interface": "package manager",
        "collections": ["packages"],
        # _detect names WHICH manager this host has, and it is the capability
        # probe as well as an acquisition — pinning it is what lets one host
        # replay a dpkg capture and an rpm capture without either reading the
        # other's interface. The row readers are captured per manager, so a
        # variant stages exactly the one its _detect names.
        "acquisitions": {
            "_detect": "manager",
            "_dpkg_rows": "dpkg",
            "_rpm_rows": "rpm",
            "_nix_store_paths": "nixstore",
        },
        "instance": {},
    },
    "nix": {
        "module": nixos,
        "adapter": nix.Adapter,
        "interface": "nix profile",
        "collections": ["generations"],
        # The tree seam, over the five primitives agent/nixos.py exposes and
        # the JSON reader that rides `read`. Everything the collection needs
        # is one of these: the profile link farm (listdir + readlink), the
        # three closure pointers (realpath), each generation's small files
        # (read), the link's own creation time (mtime), and whether this host
        # activated a closure at all (exists).
        "path_acquisitions": {
            "read": "read",
            "listdir": "listdir",
            "realpath": "realpath",
            "readlink": "readlink",
            "mtime": "mtime",
            "exists": "exists",
        },
        # The one read in agent/nixos.py that is not a file: the receipts
        # directory comes from the environment, so the seam substitutes the
        # FUNCTION and a variant that captured no receipts pins it to None —
        # which is exactly what a process nobody pointed at a receipts
        # directory sees. Auxiliary rather than an acquisition, because a
        # missing one qualifies the reading instead of meaning the interface
        # was absent. Without this the reference read the environment of the
        # machine REPLAYING, and the Deployment fact was capturable by nothing.
        "auxiliary": {"receipts_dir": ("receipts-dir", None)},
        # Deltas OFF under replay, and this is the 2026-08-19 ruling rather
        # than a convenience. What CHANGED between two generations left the
        # rewrite's scope, to a plugin once a plugin surface exists; the walk
        # that computes it goes through `_etc_entries`, `_tree_entries` and
        # `store_paths`, none of which ride these primitives, so a replay with
        # deltas on would walk the filesystem of the machine REPLAYING and put
        # its /etc into committed facts. The consequence is named and accepted
        # in the parity report: the live adapter and the ported collector
        # disagree by construction on the five delta facts and must agree on
        # every other fact in the collection.
        "instance": {"_deltas": False},
    },
    "docker": {
        "module": docker,
        "adapter": docker.Adapter,
        "interface": "docker socket",
        "collections": ["containers", "volumes", "networks"],
        # _get returns an httpx.Response and the adapter calls .json() on it,
        # so the captured document is wrapped on the way out — see the
        # response shim below. Three paths, three documents.
        "methods": ["_get"],
        "response_methods": ["_get"],
        "instance": {},
    },
    "traefik": {
        "module": traefik,
        "adapter": traefik.Adapter,
        "interface": "traefik api",
        "collections": ["overview", "routers", "services"],
        # Two fetchers, and both must be stubbed: _get is a single document,
        # _get_list is the pagination loop that follows X-Next-Page. Stubbing
        # only the first would leave the loop calling self._client against
        # whatever URL the replaying machine has in its environment.
        "methods": ["_get", "_get_list"],
        "instance": {"url": "http://replay.invalid"},
    },
    "bazarr": {
        "module": bazarr,
        "adapter": bazarr.Adapter,
        "interface": "bazarr api",
        "collections": ["instance"],
        # One fetcher, dispatched on the path — `/api/system/status` and
        # `/api/system/health`, two documents from one httpx client. The plain
        # method seam and not docker's response one: this adapter calls .json()
        # inside _get and hands back the parsed document, so wrapping it in a
        # CapturedResponse would fail on the first attribute the caller does not
        # use.
        "methods": ["_get"],
        # All three pinned, and none of them is decoration. `url` is what _get
        # would dial the moment the stub were removed, which is the same reason
        # traefik and unbound pin theirs. The other two are read by
        # _instance_items BEFORE any fetch: unpinned, the adapter reads
        # SE_BAZARR_API_KEY from the environment of the machine REPLAYING the
        # corpus, finds none, and publishes a receipts-incomplete row from a
        # variant whose payloads are the API answering.
        "instance": {"url": "http://replay.invalid",
                     "_key_set": True, "_key_problem": None},
    },
    "paperless": {
        "module": paperless,
        "adapter": paperless.Adapter,
        "interface": "paperless api",
        "collections": ["instance"],
        # One fetcher dispatched on the path, two documents. `_get` parses
        # inside itself and hands back the document, so this is bazarr's plain
        # method seam and not docker's response one.
        "methods": ["_get"],
        # All four pinned, and the two token members are the load-bearing
        # pair. capability() reads _token_set and _token_problem BEFORE any
        # fetch, so an unpinned replay would read SE_PAPERLESS_TOKEN from the
        # environment of the machine REPLAYING the corpus, find none, and
        # declare the whole subsystem unavailable — from a variant whose
        # payloads are the API answering. display_url is pinned beside url
        # because capability() echoes it into the envelope.
        "instance": {"url": "http://replay.invalid",
                     "display_url": "http://replay.invalid",
                     "_token_set": True, "_token_problem": None},
    },
    "plex": {
        "module": plex,
        "adapter": plex.Adapter,
        "interface": "plex api",
        # THREE collections, not the adapter's four. `requests` is seerr's,
        # and seerr cannot be stood up in the lab: its first-run setup
        # authenticates against a Plex ACCOUNT, and the estate's account is
        # exactly what a test may not touch. Leaving it out of this list is
        # what stops `collect requests:1` reaching the live seerr of whichever
        # machine replays; the gap itself is carried in NAMED_RESIDUALS rather
        # than by this silence, because a collection nobody could ask about
        # must not render the same as one that had nothing to say.
        "collections": ["server", "libraries", "sessions"],
        # _plex_get(path, params) — dispatched on the path, which is what
        # decides the document; params carry only the zero-size container
        # window and would key five files onto one name. The seerr half of
        # this adapter reads through `self._seerr` DIRECTLY rather than
        # through a method, so it has no seam here at all — another reason
        # `requests` is not in the list above.
        "methods": ["_plex_get"],
        # seerr_url pinned to None so `requests` declines as unavailable for
        # the stated reason rather than dialling anything, and the token
        # members pinned for the same reason as paperless's: capability()
        # reads them before any fetch.
        "instance": {"plex_url": "http://replay.invalid",
                     "seerr_url": None,
                     "_plex_token_set": True, "_plex_problem": None,
                     "_seerr_key_set": False},
    },
    "unbound": {
        "module": unbound,
        "adapter": unbound.Adapter,
        "interface": "unbound control socket",
        "collections": ["daemon"],
        # One command, one connection, one document — so the payload is keyed
        # on the command, and the two on the acquisition path are `status` and
        # `stats_noreset`. The _noreset suffix is load-bearing rather than
        # decorative: plain `stats` ZEROES the counters as a side effect of
        # reporting them, so a capture taken with it would both lie about this
        # host and destroy the reading it came from.
        #
        # The payloads are .txt, not .json: the control socket answers in a
        # line protocol and the native format IS the payload (DESIGN 20), so
        # load_payloads hands the exact bytes to the same parser the live
        # adapter runs. Wrapping them in a JSON string would put a
        # transcription between the capture and the code under test.
        "methods": ["_command"],
        # Pinned rather than left alone. The adapter reads SE_UNBOUND_SOCKET
        # in __init__, so an unpinned replay would carry whatever the machine
        # REPLAYING the corpus has in its environment — nothing dials it once
        # _command is stubbed, but a replay whose adapter state depends on the
        # ambient environment is one seam edit away from dialling it.
        "instance": {"socket_path": "/replay.invalid/unbound.ctl"},
    },
    # ── a fleet: one adapter, several instances of one application ───────
    "servarr": {
        "module": servarr,
        "adapter": servarr.Adapter,
        "interface": "servarr api",
        "collections": ["apps", "health", "queue", "history"],
        # The fleet is CONFIGURATION, not an interface reading, and
        # instance_specs() is the zero-argument module-level acquisition that
        # reads it — the same shape as packages' _detect, which names WHICH
        # manager answered. Pinning it is what stops the environment of the
        # machine REPLAYING the corpus deciding which fleet this capture is
        # of: SE_SERVARR_INSTANCES is read at Adapter() construction, before
        # any stub could intervene. The payload carries the half a public
        # corpus may hold — each instance's name, its API family, and which
        # receipts were missing — and `fleet` completes the two it may not;
        # see fleet_specs() for why no URL is captured and no key ever can be.
        "fleet": {"instance_specs": "instances"},
        # _get(spec, path, params) takes the INSTANCE SPEC first, so the
        # dispatched-on-the-first-argument seam would key all six of an
        # instance's documents on one spec dict and hand back whichever
        # happened to slug the same. WHICH document comes back is decided by
        # the instance and the path together — which is precisely the URL this
        # adapter builds, `<url>/api/<family><path>` — so the payload is keyed
        # on the instance name plus that path, and a reviewer reading
        # radarr-api-v3-system-status.json can see the request it answers.
        #
        # The params are deliberately NOT part of the key. The one dispatched
        # call that varies them is the queue walk's page number, and a capture
        # whose queue exceeds one 250-record page would replay page 1 forever
        # until QUEUE_MAX_PAGES stopped it — a bound worth stating rather than
        # a key nobody could read.
        "fleet_methods": ["_get"],
        "instance": {},
    },
    "kea": {
        "module": kea,
        "adapter": kea.Adapter,
        "interface": "kea control socket",
        "collections": ["daemon", "subnets", "reservations", "leases"],
        # The same one-command-one-connection shape as unbound, and the same
        # dispatched seam — but the answers are JSON, so the payloads are
        # .json and load_payloads parses them exactly as the adapter's own
        # json.loads would. Five commands sit on the acquisition path
        # (version-get, status-get, statistic-get-all, config-get,
        # lease4-get-all) and list-commands sits on the capability one; all
        # six are keyed on the command, because the command is what decides
        # which document comes back.
        #
        # `leases` is in this list and is gated on a HOOK. lease4-get-all
        # ships in libdhcp_lease_cmds, so a Kea with no hooks loaded does not
        # offer it at all — which capability() turns into an unavailable
        # collection naming the hook. acquire() re-checks nothing, so this
        # seam serves the collection from a captured payload wherever one
        # exists and refuses (never falls through to a live socket) where one
        # does not.
        "methods": ["_command"],
        # Pinned for the reason unbound's is: the adapter reads SE_KEA_SOCKET
        # in __init__, so an unpinned replay would carry whatever the machine
        # REPLAYING the corpus has in its environment.
        "instance": {"socket_path": "/replay.invalid/kea4-ctrl-socket"},
    },
    "downloaders": {
        "module": downloaders,
        "adapter": downloaders.Adapter,
        "interface": "download client",
        "collections": ["clients", "transfers"],
        # TWO dispatched methods, and both must be stubbed. _rpc(method) is
        # transmission — session-get, session-stats, torrent-get, three calls
        # whose whole difference is the method name — and _sab(mode) is
        # sabnzbd. Stubbing one would leave the other client dialling whatever
        # URL the replaying machine has in its environment, and the adapter
        # degrades PER CLIENT: the dark half would come back as a
        # StatusUnobservable row carrying this shim's own error text as a
        # committed fact, which reads as a statement about a machine and is a
        # statement about the harness.
        #
        # The payload is what _rpc RETURNS, which is the `arguments` member of
        # the RPC reply rather than the whole envelope. That is the same
        # boundary docker's captures draw: `result: "success"` is
        # transmission's status line, the HTTP status's equivalent, and the
        # body is the document. `curl -X POST … -d '{"method":"session-get"}'`
        # — the adapter's own reference command — hands a reader both halves,
        # and the payload is the half the parser sees.
        "methods": ["_rpc", "_sab"],
        # Pinned, and load-bearing in a way no other seam entry's is: these
        # three are not addressing, they are the CAPABILITY GATE. The adapter
        # builds a transmission row only if transmission_url is set, a sabnzbd
        # row only if sab_url is, and asks sabnzbd for transfers only if
        # sab_key is — the direct analogue of storage's `_zfs`. Unpinned, a
        # replay would publish whichever clients the REPLAYING machine's
        # environment happens to name.
        #
        # Pinned as constants, they also fix what a downloaders variant IS: a
        # host running both clients. A one-client host is a real shape and
        # this seam cannot express it, because the gates are per-collector
        # here and would have to be per-variant — so a capture stages all four
        # documents or none, and se-capture-guest's downloaders case says the
        # same thing at the other end.
        "instance": {"transmission_url": "http://replay.invalid",
                     "sab_url": "http://replay.invalid",
                     "sab_key": "replay.invalid"},
    },
    # ── the one collector with no acquire(), and the shape that follows ──
    "logs": {
        "module": logs,
        "adapter": logs.Adapter,
        "interface": "systemd journal",
        "collections": ["journal"],
        # _run_journalctl(args) is module-level and returns the parsed entries,
        # but WHICH entries depends entirely on the argument list — so it takes
        # the dispatched module seam and the payload is keyed on slug(args):
        # `-r -n 100` becomes `r---n--100.json`, which is the argv a reviewer
        # can re-run by hand against the guest it came from.
        "arg_acquisitions": ["_run_journalctl"],
        # logs has NO acquire() method. That is by design and not an omission:
        # a bounded journal query has no "all items" to materialise, so the
        # adapter's only materialising verb is collect(). Declaring the page
        # here is what makes that a second dispatch shape rather than an
        # inconsistency — see se_harness.emission.materialise, which explains
        # why the choice is declared beside the collector instead of inferred
        # from whether acquire() happens to exist.
        #
        # The page itself is the plainest the contract admits: no filters, no
        # cursor, and limit=None so the bound is logs.DEFAULT_LIMIT rather than
        # a number chosen here. The collector contract carries no limit token
        # (DESIGN 18), so the bound belongs to the collector — and taking it
        # from the adapter is what stops this table, se-capture-guest and the
        # ported binary from each holding their own copy of it.
        "page": {"query": {}, "limit": None, "cursor": None},
        "instance": {},
    },
    "protection": {
        "module": protection,
        "adapter": protection.Adapter,
        "interface": "homelab protection surfaces",
        "collections": ["targets", "jobs", "destinations"],
        # _load(path) is module-level and dispatched on the path, so the
        # payload is keyed on slug(path) and a reviewer reading
        # `var-lib-homelab-protection-receipts-checkin.last.json.json` can see
        # which file it is. The whole collect path goes through it: jobs are
        # enumerated from status.json's own list, never from a directory
        # walk, so the os.listdir in _receipt_jobs sits on the EVIDENCE path
        # alone and no collection depends on it.
        "arg_acquisitions": ["_load"],
        # The load-bearing pin, and the reason this entry is not just the two
        # lines above. A target's opinions fire only where its ownerHost
        # matches THIS host — `env.HOST["hostname"]` — so an unpinned replay
        # would judge the capture against whichever machine happened to be
        # replaying it: every target unowned on a workstation, every target
        # owned on a host that shares the captured name. Severity would move
        # with the replaying machine while the payloads sat still. Pinned from
        # the capture, like hardware's.
        "host": {"hostname": "hostname"},
        "instance": {},
    },
    # ── the one TREE-shaped interface: the document is the filesystem ────
    "resources": {
        "module": resources,
        "adapter": resources.Adapter,
        "interface": "cgroup v2 hierarchy",
        "collections": ["workloads"],
        # Both readers, because both are the interface. DESIGN's tree-shape
        # ruling (2026-08-19) says the native document for a filesystem is the
        # filesystem transcribed — the listings walked PLUS the contents of
        # every file read — so a reader with the payloads can `cat` any path
        # and compare. Stubbing only the reads would leave `_walk` enumerating
        # the cgroup tree of whichever machine is REPLAYING, which is the seam
        # escape that once put a workstation's filesystem into committed facts.
        #
        # `_read_text` is keyed on the path and `_walk` on its root, so the
        # payload directory IS the path→content map: `sys-fs-cgroup.json`
        # holds the listings os.walk yielded, in the order it yielded them —
        # load-bearing, because the shallowest occurrence of a duplicated unit
        # name wins and that depends on walk order — and every other file is
        # one path's contents under slug(path). A path that did not exist is
        # `null`, not an empty document: absent and empty are different
        # answers here, and the whole collection turns on keeping them apart.
        "arg_acquisitions": ["_read_text", "_walk"],
    },
    # ── the tree-shaped seam: one document per primitive, keyed by path ──
    "hardware": {
        "module": hardware,
        "adapter": hardware.Adapter,
        "interface": "sysfs",
        "collections": ["platform", "pci", "usb", "scsi", "nvme"],
        # lscpu is a command that answers with a document, so it takes the
        # ordinary zero-argument seam. /proc/meminfo does NOT appear here on
        # purpose: _meminfo_total_bytes reads it through _read, so pinning the
        # derived integer would stub out the parse the port has to reproduce —
        # the kernel file itself is in the read map, where it belongs.
        "acquisitions": {"_lscpu_json": "lscpu"},
        # Ruled 2026-08-19 (DESIGN, adjudication queue, "what a captured
        # payload is for a TREE-shaped interface"): the native document for a
        # filesystem interface is the filesystem transcribed — the directory
        # listings the collector walked plus the contents of every file it
        # read. So each primitive gets ONE document, keyed directory-then-name,
        # and a reviewer can `cat` any path on the guest and compare.
        #
        # One document and not one file per path, for a reason the dispatched
        # seam cannot serve: on a sysfs walk "there is no such file" is an
        # ORDINARY reading — six firmware attribute names are tried per scsi
        # host and at most one of them exists — so a null sits beside the
        # values and is a captured answer rather than an uncaptured one. A path
        # the capture does not hold still raises, so this stays deny-by-default
        # exactly like the other kinds: it can never read the tree of the
        # machine REPLAYING the corpus.
        #
        # _realpath and _exists are here because neither reads a file and both
        # are readings all the same — which ata port a disk hangs from, which
        # PCI function a host adapter is, whether a scsi host publishes a SAS
        # address. Unpinned they do not fail, they ANSWER, out of the tree of
        # whichever machine is replaying: realpath returns a missing path
        # unchanged, so the walk finds no ata port and publishes a host with no
        # transport, and exists answers about the replaying host's own scsi
        # tree. Both were unstubbed until 2026-08-19, which meant a pair was
        # not a function of its payload — a SAS host replaying a SATA capture
        # read SAS out of its own /sys.
        #
        # The three smart maps are captured empty on a guest with no block
        # device in either walk, and empty is the whole point of declaring
        # them: without these entries a replay would run `smartctl` against
        # the disks of whichever machine is replaying.
        "path_acquisitions": {
            "_read": "read",
            "_listdir": "listdir",
            "_realpath": "realpath",
            "_exists": "exists",
            "_udev_json": "udev",
            "_smartctl_json": "smartctl",
            "_smart_snapshot": "smart-snapshot",
            "_smart_no_reading": "smart-reason",
        },
        # udisks2 is reached through the D-Bus singleton rather than a module
        # function, so the seam is the singleton: an object that refuses. No
        # committed variant carries a udisks2 document — see
        # corpus.NAMED_RESIDUALS["hardware/udisks2-smart"] — and refusing is
        # what the adapter's own degradation already handles, by the same path
        # a host with no udisks2 on the bus takes.
        "refusing_bus": "udisks2",
        # env.HOST is read from the kernel at import and hardware mints the
        # platform object's id from its hostname, so an unpinned replay names
        # the object after whichever machine is REPLAYING and one capture
        # produces a different object on every host that reads it. Pinned from
        # the capture's own payload, which is the discipline every acquisition
        # here takes: the corpus, never the replaying host.
        "host": {"hostname": "hostname"},
    },
    # ── the fifth seam kind: an interface that answers REQUESTS ─────────
    "units": {
        "module": units,
        "adapter": units.Adapter,
        "interface": "systemd on the system bus",
        "collections": ["units"],
        # Everything this adapter reads goes through one shared singleton —
        # `from ..sysbus import BUS` — so there is no module-level acquisition
        # to redirect and no per-instance fetcher to bind. The seam is the
        # singleton itself: `units.BUS` is replaced by an object answering the
        # same two coroutines against the capture.
        #
        # The payload is a request/response MAP rather than one document,
        # because this interface has no single document to be. A collection
        # here is 2 manager calls, one Properties.GetAll per unit systemd could
        # not load, and one Properties.Get per service and scope — 284 replies
        # on the guest this was captured from — and each is keyed on the
        # request that produced it: the busctl argument line, path first, so a
        # reader can paste a key after `busctl call org.freedesktop.systemd1 `,
        # add `--json=short`, and compare against the value beside it.
        "bus": "BUS",
        "instance": {},
    },
    "network": {
        "module": network,
        "adapter": network.Adapter,
        "interface": "nft",
        # One payload, two collections: nft-chains and nft-rules are both
        # derived from the same `nft -j list ruleset` document, and a request
        # naming both replays them from this single redirect, deterministically
        # — test_reference_honesty drives that request and holds each commit
        # to its own issued generation. corpus/network/rules is the committed
        # pair, which is what closed the named residual that stood here while
        # the round-a5 chains-only fixtures were the only subjects.
        "collections": ["nft-chains", "nft-rules"],
        "acquisitions": {"_nft_json": "nft"},
        "instance": {},
    },
}


def load_payloads(directory: Path) -> dict[str, object]:
    """Every captured document, keyed by file stem.

    `.json` is parsed; anything else is handed over as the exact text, because
    not every native interface answers in JSON — unbound's control socket
    replies in plain text, os-release and the kernel hostname ARE text — and
    wrapping those in a JSON string would put a transcription between the
    capture and the parser it feeds.

    Every file, exactly as se_harness.corpus.load_variant reads them, and that
    is the point rather than a convenience: this globbed `*.json` and `*.txt`
    only, so a payload committed under a bare stem — which is the form the
    corpus loader and the differential guard's writer both produce — was
    silently invisible here while sitting in the directory. Dotfiles stay
    behind; the .gitkeep marking an absent-interface variant is git plumbing,
    never a capture.
    """
    payloads: dict[str, object] = {}
    for path in sorted(directory.iterdir()):
        if not path.is_file() or path.name.startswith("."):
            continue
        payloads[path.stem] = (
            json.loads(path.read_text()) if path.suffix == ".json"
            else path.read_text()
        )
    return payloads


def slug(argument: object) -> str:
    """A payload file name for a dispatched acquisition's argument.

    An HTTP path, a control-socket command, a file path — all of them are the
    argument that decides WHICH document comes back, so they are what the
    payload is keyed on. Reversible enough to read: a reviewer looking at
    `api-http-routers.json` can see which request it answers, which is most of
    what a corpus is for.
    """
    text = str(argument).strip("/")
    keep = [c if (c.isalnum() or c in "-_.") else "-" for c in text]
    name = "".join(keep).strip("-").replace("--", "-")
    return name or "root"


def uncaptured(payload_name: str):
    """An acquisition whose payload the variant did not capture.

    It must never fall back to the live interface of the machine REPLAYING
    the corpus — that is exactly the seam escape that put the replaying
    workstation's filesystem into committed facts — so it raises, and the
    adapter's own degradation decides what that costs (zpool list is
    enrichment and degrades to unobservable capacity facts; zpool status is
    the fact source and cannot).
    """

    def read(*_args, **_kwargs):
        raise RuntimeError(f"payload {payload_name!r} was not captured in this variant")

    return read


# The statuses a fleet capture records, in the payload that carries them. An
# HTTP interface answers some requests with a status and NO document —
# prowlarr's /queue is 404 with Content-Length 0 — so the response's whole
# content is its status line, and a zero-byte file could not carry it (the
# capture tool refuses one, rightly, as an interface that answered with
# nothing). Recording the code is therefore not a transcription of a document;
# it is the document. Deny-by-default is untouched: an uncaptured request
# still raises, and only a request this file NAMES answers with a status.
RESPONSE_CODES = "response-codes"

# And only 404 may be named. 404 is the one status whose effect on the adapter
# is independent of the exception's own text — both handlers branch on the
# code and nothing else — while every other status lands in a FACT VALUE
# spelled by httpx (`QueueUnobservable`, `f"{type(exc).__name__}: {exc}"`),
# which no independent implementation can reproduce and no corpus should
# therefore enshrine. A capture that met one is a finding for the adjudication
# queue, not a payload to commit.
REPLAYABLE_CODES = (404,)


def fleet_specs(captured: object, payload_name: str) -> list[dict]:
    """instance_specs()'s answer, completed with what a public corpus may not
    hold.

    The capture carries name, api, missing and duplicates — everything
    instance_specs() derives from SE_SERVARR_INSTANCES that is safe to
    publish. The two it withholds are the two that are not: the URL is where
    an instance sits in an estate (location), and the API key is a credential,
    which DESIGN 21 says must never have been captured at all — no amount of
    scrubbing repairs a payload that holds one.

    So they are supplied HERE, in code, rather than committed: a
    replay-invalid URL and a placeholder key, exactly as the traefik seam pins
    `http://replay.invalid`. Nothing dials either, because _get is stubbed —
    but Adapter.__init__ builds its per-instance client from them, and an
    instance with no client is not `_ready`, so a fleet whose receipts were
    complete at capture must replay as complete or the fan-out would find
    nothing to fan out over. An instance the capture recorded as MISSING its
    receipts keeps them missing, which is the whole of what that half of the
    payload is for.
    """
    if not isinstance(captured, list):
        raise RuntimeError(
            f"payload {payload_name!r} is not a list of instance receipts"
        )
    specs = []
    for entry in captured:
        missing = list(entry.get("missing") or [])
        specs.append({
            "name": entry["name"],
            "api": entry.get("api") or "v3",
            # A withheld receipt is withheld from the client too: the row this
            # instance gets is the ConfigMissing one, and a fabricated URL
            # would turn a stated fault into an instance that silently worked.
            "url": None if missing else f"http://{entry['name']}.replay.invalid",
            "key": None if missing else "replay-not-a-key",
            "missing": missing,
            "duplicates": list(entry.get("duplicates") or []),
        })
    return specs
def by_path(label: str, payload_name: str, document: object):
    """A stub that answers a TREE-shaped acquisition out of one document.

    The captured document holds every path the collector asked the interface
    about and what came back — including the nulls, because on a filesystem
    walk "there is no such file" is an ordinary reading the adapter degrades
    through rather than an absence of capture. A path that IS in the document
    is answered with whatever it holds, null included; one that is not raises,
    because the variant never recorded that read and falling back would read
    the tree of the machine REPLAYING the corpus.

    Keyed the way a filesystem is — the directory, then the name inside it —
    rather than by the whole path as one string, and that shape is load-bearing
    twice. It is how a reviewer reads it: one object per directory, its
    attributes beside each other, `cat`-able against the guest one line at a
    time. And it is the granularity the scrub manifest classifies at (DESIGN
    21): `*.wwid` is one written claim about a field of this interface, where
    a flat map offers only the whole path — either forty literal entries that
    a guest with one more disk invalidates, or a single `*` that classifies a
    WWN and a link rate as one thing, which is the audited failure the manifest
    exists to prevent.

    An argument with no directory part (a device NAME — smartctl's snapshot
    files are addressed that way) lands under the empty container, so the rule
    stays one rule.
    """
    entries = document if isinstance(document, dict) else {}

    def answer(argument, *_args, **_kwargs):
        container, _, member = str(argument).rpartition("/")
        inside = entries.get(container)
        if not isinstance(inside, dict) or member not in inside:
            raise RuntimeError(
                f"{label} {argument!r} was not captured in this variant "
                f"(payload {payload_name!r}); the tree seam refuses to read "
                "the filesystem of the machine replaying the corpus"
            )
        return inside[member]

    return answer


class RefusingBus:
    """The D-Bus singleton, for a variant that captured no bus reply.

    Not a stub that answers: an adapter reading D-Bus under replay must reach
    no bus at all, and the one thing worse than an uncaptured reply is a reply
    from the session the replaying machine happens to be running. Raising is
    the reading the adapter already knows how to take — hardware's
    _drive_health catches it and records that udisks2 is not on the bus, which
    is what a host without the daemon produces too.
    """

    def __init__(self, payload_name: str) -> None:
        self._payload_name = payload_name

    async def call(self, destination, path, interface, member, *_a, **_k):
        raise RuntimeError(
            f"{destination}.{member} was not captured in this variant "
            f"(payload {self._payload_name!r}); the bus seam refuses to dial "
            "the system bus of the machine replaying the corpus"
        )

    async def get_all(self, destination, path, interface):
        return await self.call(destination, path, interface, "GetAll")
# ── the D-Bus seam: busctl's own JSON, decoded the way dbus-fast is ──────
#
# DESIGN's 2026-08-19 ruling: the native document for a D-Bus interface is
# systemd's OWN rendering, `busctl call … --json=short`, which carries the type
# signature beside the data ({"type":"a(ssssssouso)","data":[…]}). So nothing
# below transcribes a reply into a shape this repository invented — it decodes
# a self-describing document using the signature the document states, which is
# what makes a `from` path into it checkable by re-running one command.
#
# The decode target is exactly what `sysbus.unwrap` hands the adapter: variants
# replaced by their values, structs and arrays as lists, dicts as dicts, `ay`
# base64-wrapped. Signature-driven and never shape-guessed, because a{sv} and a
# variant are both JSON objects and only the signature tells them apart.


def complete_types(signature: str) -> list[str]:
    """A signature split into its complete types — one per reply argument."""
    types, index = [], 0
    while index < len(signature):
        width = type_width(signature, index)
        types.append(signature[index:index + width])
        index += width
    return types


def type_width(signature: str, index: int) -> int:
    kind = signature[index]
    if kind == "a":
        return 1 + type_width(signature, index + 1)
    if kind in "({":
        closing = ")" if kind == "(" else "}"
        depth = 0
        for offset in range(index, len(signature)):
            if signature[offset] in "({":
                depth += 1
            elif signature[offset] in ")}":
                depth -= 1
                if depth == 0:
                    if signature[offset] != closing:
                        raise ValueError(f"unbalanced signature {signature!r}")
                    return offset - index + 1
        raise ValueError(f"unterminated container in signature {signature!r}")
    return 1


# The integer tokens. Kept apart from `d` because a double that arrived as an
# int would silently become one, and pass-through numbers keep the WIRE's type
# (DESIGN 19's ruling on typed equality).
DBUS_INTEGERS = frozenset("ynqiuxth")


def decode_typed(signature: str, value):
    """One value, decoded under the type the document declares for it."""
    kind = signature[0]
    if kind == "a":
        inner = signature[1:]
        if inner.startswith("{"):
            key_type = inner[1]
            if key_type != "s":
                raise ValueError(f"dict key type {key_type!r} is not captured yet")
            value_type = inner[2:-1]
            return {k: decode_typed(value_type, v) for k, v in value.items()}
        if inner == "y":
            # dbus-fast unmarshals `ay` to bytes and sysbus.unwrap base64-wraps
            # it, because a byte string is not JSON. Reproduced here so the two
            # readings of one property cannot differ — though nothing on the
            # acquisition path reads one, so no committed pair judges this arm.
            import base64
            return {"__bytes_base64__":
                    base64.b64encode(bytes(value)).decode("ascii")}
        return [decode_typed(inner, item) for item in value]
    if kind == "(":
        parts = complete_types(signature[1:-1])
        return [decode_typed(part, item)
                for part, item in zip(parts, value, strict=True)]
    if kind == "v":
        # The one place the document nests its own type: a variant is
        # {"type": …, "data": …}, and unwrap replaces it by its value.
        return decode_typed(value["type"], value["data"])
    if kind == "b":
        if not isinstance(value, bool):
            raise ValueError(f"boolean member is {value!r}")
        return value
    if kind == "d":
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            raise ValueError(f"double member is {value!r}")
        return float(value)
    if kind in DBUS_INTEGERS:
        if isinstance(value, bool) or not isinstance(value, int):
            raise ValueError(f"{signature} member is {value!r}")
        return value
    if kind in "sog":
        if not isinstance(value, str):
            raise ValueError(f"{signature} member is {value!r}")
        return value
    raise ValueError(f"signature {signature!r} is not decoded yet")


def decode_reply(document: dict) -> list:
    """A busctl document as the reply BODY the adapter would have received.

    `data` is the argument list and `type` is their concatenated signature, so
    the two zip — which is also the check that the document is the one it says
    it is.
    """
    return [decode_typed(part, value) for part, value
            in zip(complete_types(document["type"]), document["data"], strict=True)]


def bus_request(path: str, interface: str, member: str,
                signature: str, body: list) -> str:
    """The key one reply is committed under: the busctl argument line.

    Path, interface, member — the address DESIGN's ruling names — followed by
    the signature and arguments where there are any, because `Get` on one
    object path is two different questions depending on which interface and
    property it names. Everything after `busctl call org.freedesktop.systemd1 `,
    verbatim, so re-running a captured request is a copy and a paste.
    """
    parts = [path, interface, member]
    if signature:
        parts.append(signature)
        parts.extend(str(argument) for argument in body)
    return " ".join(parts)


class CapturedBus:
    """`units.BUS`, answering from the capture instead of from the system bus.

    Deny-by-default like every other seam kind: a request the variant did not
    stage raises rather than reaching the bus of whichever machine is replaying
    the corpus. But the adapter CATCHES broadly on both per-unit paths — a unit
    genuinely can vanish between the listing and the probe, and the adapter is
    right to survive that — so a miss here would be swallowed into a plausible
    row instead of a loud failure. Every miss is therefore recorded as well as
    raised, and the run fails on the record: the call set is a function of the
    ListUnits document, so a request that was not captured is a broken capture
    and never a statement about a machine.
    """

    def __init__(self, documents: dict[str, dict]) -> None:
        self._documents = documents
        self.uncaptured: list[str] = []

    async def call(self, destination: str, path: str, interface: str, member: str,
                   signature: str = "", body: list | None = None) -> list:
        request = bus_request(path, interface, member, signature, body or [])
        document = self._documents.get(request)
        if document is None:
            self.uncaptured.append(request)
            raise RuntimeError(
                f"{request!r} was not captured in this variant; the bus seam "
                "refuses to read the system bus of the machine replaying the "
                "corpus"
            )
        return decode_reply(document)

    async def get_all(self, destination: str, path: str, interface: str) -> dict:
        body = await self.call(destination, path, PROPERTIES, "GetAll", "s",
                               [interface])
        return body[0]


def captured_requests(payloads: dict[str, object]) -> dict[str, dict]:
    """Every staged reply, keyed by its request, across every payload file.

    One collection is hundreds of replies of four shapes, so they are committed
    in one file per SHAPE — the scrub manifest classifies by path, and a
    manifest cannot say that index 1 of a row is a description in one document
    and an enablement state in another. The seam addresses them as one map,
    because the adapter addresses the bus and not a file.
    """
    documents: dict[str, dict] = {}
    for stem, payload in sorted(payloads.items()):
        if not isinstance(payload, dict):
            fail(f"payload {stem!r} is not a request/response map")
        for request, document in payload.items():
            if request in documents:
                fail(f"{request!r} is staged twice; one request, one reply")
            documents[request] = document
    return documents


class CapturedResponse:
    """A captured document wearing an httpx.Response's face.

    Only the members an adapter actually uses on the acquisition path, and no
    more: a fuller fake would be a second implementation of httpx that could
    disagree with the real one about something nobody tested.
    """

    def __init__(self, document: object) -> None:
        self._document = document
        self.status_code = 200
        self.headers: dict[str, str] = {}

    def json(self) -> object:
        return self._document

    def raise_for_status(self) -> "CapturedResponse":
        return self

    @property
    def text(self) -> str:
        return json.dumps(self._document)


def run(collector: str, generations: dict[str, int], payload_dir: Path) -> None:
    spec = SEAM.get(collector)
    if spec is None:
        fail(f"unknown collector {collector!r}; known: {sorted(SEAM)}")

    # Refused before anything is acquired, and refused as "I could not run"
    # rather than declined: a decline states something about a machine, and
    # this shim observed no machine at all for a collection whose acquisition
    # it never stubbed. The live adapter would happily answer — which is the
    # danger, since the interface it would read belongs to whichever host is
    # REPLAYING the corpus, not to the one captured.
    unservable = [c for c in generations if c not in spec["collections"]]
    if unservable:
        fail(
            f"{collector}: cannot replay {unservable} — this seam stubs only "
            f"{spec['collections']}, and acquiring anything else would read "
            "the live interface of the machine replaying the corpus"
        )

    payloads = load_payloads(payload_dir)
    module = spec["module"]

    def dispatched(kind: str, label: str):
        """A stub that answers by ARGUMENT rather than by being called.

        Ten of the seventeen adapters have no module-level acquisition at all
        — they read through an httpx client, a unix socket or the D-Bus
        singleton, held on the instance — so the whole document a stub must
        return depends on which path, command or file was asked for. This is
        the seam kind for those, and it is deny-by-default like the other one:
        an argument the variant did not capture raises rather than reaching
        the live interface of whichever machine is replaying.
        """

        def answer(*args, **kwargs):
            argument = args[0] if args else next(iter(kwargs.values()), "")
            name = slug(argument)
            if name not in payloads:
                raise RuntimeError(
                    f"{label} {argument!r} (payload {name!r}) was not captured "
                    f"in this variant; the {kind} seam refuses to read the live "
                    "interface of the machine replaying the corpus"
                )
            return payloads[name]

        async def async_answer(*args, **kwargs):
            return answer(*args, **kwargs)

        async def async_response(*args, **kwargs):
            # Some adapters hold the HTTP response rather than its body —
            # docker's _get returns an httpx.Response and the caller decides
            # between .json() and the raw bytes. Handing back the parsed
            # document there would fail on the first attribute access, so the
            # captured document is wrapped in the smallest object that keeps
            # the caller's own contract visible.
            return CapturedResponse(answer(*args, **kwargs))

        if kind == "response":
            return async_response
        return async_answer if kind == "method" else answer

    def fleet_dispatched(label: str):
        """A stub for a fetcher whose first argument is the INSTANCE.

        One adapter fronts a fleet — several instances of one application,
        each its own HTTP endpoint — so the document that comes back is
        decided by the instance and the request path together, and a stub
        keyed on the first argument alone would key on the instance and hand
        every path the same document. The key is what the adapter itself
        builds: the instance's name and `/api/<family><path>`.

        Deny-by-default, twice. A request the variant did not capture raises,
        exactly as the dispatched seam does. And a request the capture
        recorded as answering with a STATUS and no body raises the error the
        adapter branches on — httpx's own, because the adapter catches
        httpx.HTTPStatusError by type and a stand-in of this shim's own
        invention would be testing the shim.
        """
        codes = payloads.get(RESPONSE_CODES) or {}
        for name, status in sorted(codes.items()):
            if status not in REPLAYABLE_CODES:
                fail(
                    f"{RESPONSE_CODES}.json records {status} for {name!r}, and "
                    f"this seam replays {list(REPLAYABLE_CODES)} only: every "
                    "other status reaches a fact value spelled by httpx's own "
                    "exception rendering, which no independent implementation "
                    "can reproduce"
                )

        async def answer(instance: dict, path: str, params: dict | None = None):
            request = f"{instance['name']}/api/{instance['api']}{path}"
            name = slug(request)
            if name in payloads:
                return payloads[name]
            status = codes.get(name)
            if status is not None:
                # The URL is the replay-invalid one this shim pinned, so the
                # error carries no estate address even where an adapter
                # stringifies it into a reason.
                url = f"{instance['url']}/api/{instance['api']}{path}"
                raise httpx.HTTPStatusError(
                    f"{status} for {url} (replayed from {RESPONSE_CODES}.json)",
                    request=httpx.Request("GET", url),
                    response=httpx.Response(status),
                )
            raise RuntimeError(
                f"{label} {request!r} (payload {name!r}) was not captured in "
                "this variant; the fleet seam refuses to read the live "
                "interface of the machine replaying the corpus"
            )

        return answer

    # Decline only when EVERY interface acquisition is missing. A storage
    # capture with status but no list is a partially-readable interface, and
    # the shipping adapter degrades through it on purpose — declining there
    # would make this a second implementation rather than the reference one,
    # in the direction that destroys data, since an absent decline retires
    # objects.
    # Absence is "no document at all was captured", across every seam kind
    # this collector uses — a dispatched seam has no fixed payload names, so
    # its presence test is whether the variant staged anything.
    present = [n for n in spec.get("acquisitions", {}).values() if n in payloads]
    # Every dispatched seam kind, in one condition. Each was added by a
    # different collector and each is a way for a variant to stage documents
    # under names no fixed table lists, so a kind missing from here would read
    # as "this variant captured nothing" and decline `absent` — which commits,
    # and retires every object the collection had.
    if any(spec.get(kind) for kind in
           ("methods", "fleet_methods", "arg_acquisitions",
            "path_acquisitions", "bus")):
        present = present or list(payloads)
    absent = not present

    for attribute, payload_name in spec.get("acquisitions", {}).items():
        if payload_name in payloads:
            value = payloads[payload_name]
            setattr(module, attribute, lambda _v=value, *a, **k: _v)
        else:
            setattr(module, attribute, uncaptured(payload_name))
    for attribute, (payload_name, default) in spec.get("auxiliary", {}).items():
        value = payloads.get(payload_name, default)
        setattr(module, attribute, lambda _v=value, *a, **k: _v)
    # Module-level, but the document depends on the argument: protection's
    # _load(path), logs' _run_journalctl(args).
    for attribute in spec.get("arg_acquisitions", ()):
        setattr(module, attribute, dispatched("module", attribute))
    # The fleet, before the adapter is constructed: Adapter.__init__ calls
    # instance_specs() itself, so a stub set afterwards would arrive one line
    # too late and the constructor would have read the replaying machine's
    # environment.
    for attribute, payload_name in spec.get("fleet", {}).items():
        if payload_name in payloads:
            value = fleet_specs(payloads[payload_name], payload_name)
            setattr(module, attribute, lambda _v=value, *a, **k: list(_v))
        else:
            setattr(module, attribute, uncaptured(payload_name))
    # Module-level, and one captured document answers every argument: the
    # filesystem transcribed by path (DESIGN's tree ruling, 2026-08-19).
    for attribute, payload_name in spec.get("path_acquisitions", {}).items():
        setattr(module, attribute,
                by_path(attribute, payload_name, payloads.get(payload_name)))
    # Two seam kinds for one interface, and they are opposites — which is why
    # they have separate keys after both arrived on the same one and each
    # collector then took the other's branch.
    #
    # `refusing_bus` is for a collector that reads the bus but whose variant
    # captured no reply: hardware's one udisks2 call. It must reach NO bus, so
    # the singleton raises, and _drive_health catches that and records udisks2
    # as absent — which is what a host without the daemon produces anyway.
    #
    # `bus` is for a collector whose whole acquisition IS the bus: units, where
    # the payload set is a request/response map rather than documents.
    if spec.get("refusing_bus"):
        module.BUS = RefusingBus(spec["refusing_bus"])
    bus = None
    if spec.get("bus"):
        bus = CapturedBus(captured_requests(payloads))
        setattr(module, spec["bus"], bus)

    out = Emitter(
        sys.stdout,
        generations,
        {
            "request": "replay",
            "batch": "replay",
            "declaration": "sha256:replay",
            # A replay has no boot, so this is a fixed v4-shaped id, "5e" up
            # front so no reader mistakes it for a capture. The old "replay"
            # stub is what the shape rule now refuses; that the constant
            # itself still passes is DESIGN 19's named deferral, and the
            # venue that closes it is the live comparator — which reads the
            # machine's real boot id and compares, so a constant valid id
            # fails there in a single run rather than needing a cross-boot
            # capture nobody has taken.
            "boot_id": "5e000000-0000-4000-8000-000000000001",
            "timens": 0,
            "instance": None,
        },
        # `at` is a monotonic reading in production; under replay it is the
        # reference constant 1.0 + 0.001*i in emission order — finite,
        # positive, boot-scale and strictly advancing, so the structural rule
        # that governs it is exercised by the corpus instead of being
        # satisfied by a hardcoded zero. Whether a LIVE reading is a real
        # clock reading is the comparator's to say, not this one's.
        stamp=lambda i: round(1.0 + 0.001 * i, 3),
        # The reference's deterministic stand-ins: run-varying members are
        # rule-governed rather than byte-compared (DESIGN 19), and the rule
        # wants a batch that ran to report positive measured cost.
        costs=lambda: (0.5, 1.0),
    )
    out.begin()

    if absent:
        # absent is authoritative-empty (DESIGN 19): it must be able to retire
        # objects a previous batch published, so it declines AND commits zero.
        for collection in generations:
            out.decline(collection, "absent", f"no {spec['interface']} on this host")
            out.commit(collection, objects=0, assertions=0, unobservable=0)
        out.end()
        return

    # The host identity a captured object was named for. Required rather than
    # defaulted: env.HOST is read from the kernel at import, so a replay that
    # let it stand would name the object after the machine REPLAYING and one
    # capture would produce a different object on every host that read it —
    # silently, because a hostname is a plausible value wherever it came from.
    for key, payload_name in spec.get("host", {}).items():
        if payload_name not in payloads:
            fail(
                f"{collector}: payload {payload_name!r} pins env.HOST[{key!r}] "
                "and this variant did not capture it; without it the objects "
                "would be named after the machine replaying the corpus"
            )
        env.HOST[key] = str(payloads[payload_name]).strip()

    adapter = spec["adapter"]()
    for attribute, value in spec.get("instance", {}).items():
        setattr(adapter, attribute, value)
    # The seam for the ten adapters that acquire through an instance rather
    # than a module: an httpx client, a unix-socket command, the D-Bus
    # singleton. Bound on the INSTANCE, not the class, so one replay cannot
    # leak its stubs into another adapter constructed later in the same
    # process — which the module-level seam is immune to only because each
    # collector runs in its own process.
    for attribute in spec.get("methods", ()):
        kind = "response" if attribute in spec.get("response_methods", ()) else "method"
        setattr(adapter, attribute, dispatched(kind, attribute))
    for attribute in spec.get("fleet_methods", ()):
        setattr(adapter, attribute, fleet_dispatched(attribute))

    for collection in generations:
        try:
            items = asyncio.run(materialise(adapter, collection, spec.get("page")))
        except Exception as exc:  # a real inability to run, not a decline
            fail(
                f"{collector}/{collection}: acquisition raised "
                f"{type(exc).__name__}: {exc}"
            )
        # Before the commit, and that is the whole of it. The adapter swallows
        # a failed per-unit read on purpose — a unit really can vanish between
        # the listing and the probe — so a payload the variant never staged
        # becomes a row that merely looks thinner, and a commit over those rows
        # would claim authority for a collection nobody fully read.
        if bus is not None and bus.uncaptured:
            fail(f"{collector}: {len(bus.uncaptured)} request(s) the variant "
                 f"did not stage, first {bus.uncaptured[:3]} — the call set is "
                 "a function of the captured listing, so this is a broken "
                 "capture and not a reading of any machine")
        out.commit(collection, *out.items(collection, items))

    out.end()


def main() -> None:
    payload_dir = os.environ.get("SE_REPLAY_DIR")
    if not payload_dir:
        fail("SE_REPLAY_DIR is unset: this shim only replays, it never reads a host")
    directory = Path(payload_dir)
    if not directory.is_dir():
        fail(f"SE_REPLAY_DIR={payload_dir} is not a directory")

    line = sys.stdin.readline().strip()
    if not line:
        fail("no request line on stdin")
    parts = line.split()
    if parts[0] != "collect":
        fail(f"this shim serves collect only, not {parts[0]!r}")

    collector = os.environ.get("SE_REFERENCE_COLLECTOR")
    if not collector:
        fail("SE_REFERENCE_COLLECTOR must name which adapter to replay")

    run(collector, parse_generations(parts[1:], fail), directory)


if __name__ == "__main__":
    main()
