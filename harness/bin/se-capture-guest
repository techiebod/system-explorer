#!/usr/bin/env bash
# Capture native payloads from a lab guest into a corpus variant.
#
# The other half of a corpus pair comes from se-capture, which runs the
# reference implementation over these payloads. This half is the raw truth: what
# the interface on that guest, at that version, actually produced.
#
#   se-capture-guest <ssh-target> <collector> <variant-dir>
#
# The guest is reached through the lab's own ssh config, so this works against
# any guest vm-lab has brought up without knowing how it was addressed.
#
# Anonymisation is NOT done here. Payloads land raw, and the scrubbing pass runs
# before commit — the corpus is public, and structural consistency must be
# preserved across payloads (the same WWN in three files stays one WWN) which
# is not a per-file transformation and must not be attempted as one.

set -euo pipefail

if [[ $# -ne 3 ]]; then
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
fi

target="$1"
# ssh parses its destination as an option if it starts with a dash, so a
# crafted target could run a local command through -oProxyCommand.
if [[ $target == -* ]]; then
    echo "refusing a target that starts with '-'" >&2
    exit 2
fi
collector="$2"
variant="$3"

lab_ssh_config="$(dirname "$0")/../../test/vm-lab/.state/ssh_config"
ssh_opts=(-o BatchMode=yes)
[[ -f "$lab_ssh_config" ]] && ssh_opts+=(-F "$lab_ssh_config")

payload_dir="$variant/payloads"
mkdir -p "$payload_dir"

# What each collector reads, and under which payload FILE the replay seam
# expects to find it. Keep in step with SEAM in se-reference-collector.
#
# The left-hand side carries its extension because the extension is a
# decision: the native format IS the payload (DESIGN 20), and unbound's
# control socket answers in a line protocol, so its documents are .txt and
# only the .json ones are held to being JSON. Spelling it out beats inferring
# it — a stem that happened to contain a dot would otherwise silently opt out
# of the JSON check.
#
# devlinks is the storage adapter's _devlinks() acquisition, captured as the
# same {alias path: kernel name} map it builds live: vdev resolution goes
# through that map and nothing else, so a replay without it can only say
# "unobservable" — the capture is what lets the corpus carry the guest's OWN
# Device answers instead of the replaying machine's.
devlinks_py='
import json, os
links = {}
for tree in ("/dev/disk/by-id", "/dev/disk/by-partuuid", "/dev/mapper"):
    try:
        entries = sorted(os.listdir(tree))
    except OSError:
        continue
    for entry in entries:
        path = tree + "/" + entry
        if os.path.islink(path):
            links[path] = os.path.basename(os.readlink(path))
print(json.dumps(links))
'
vms_py='
import json, sys
sys.path.insert(0, "/tmp/secmp/src")
from system_explorer.agent.adapters.vms import _domains_raw
print(json.dumps(_domains_raw()))
'
manager_py='
import json, sys
sys.path.insert(0, "/tmp/secmp/src")
from system_explorer.agent.adapters.packages import _detect
print(json.dumps(_detect()))
'
dpkg_py='
import json, sys
sys.path.insert(0, "/tmp/secmp/src")
from system_explorer.agent.adapters.packages import _dpkg_rows
print(json.dumps(_dpkg_rows()))
'
# The journal reader, called with the exact argument list the adapter builds
# for a filterless first page: `-r` because pages run newest-first, and the
# adapter'"'"'s own DEFAULT_LIMIT because the collector contract has no limit
# token — the bound belongs to the collector, and taking it from logs.py is
# what stops a number here disagreeing with the one the port ships.
#
# Privileged: an unprivileged journalctl answers only for the caller'"'"'s own
# uid (measured on the lab guest: 200 of 200 entries _UID=1000, no kernel
# transport at all), so an unprivileged capture would be a specimen of one
# user'"'"'s session rather than of a machine'"'"'s journal.
logs_py='
import json, sys
sys.path.insert(0, "/tmp/secmp/src")
from system_explorer.agent.adapters.logs import DEFAULT_LIMIT, _run_journalctl
print(json.dumps(_run_journalctl(["-r", "-n", str(DEFAULT_LIMIT)])))
'
# servarr is a FLEET — several instances of one application, each its own HTTP
# endpoint — so the acquisition list cannot be written down here: it depends on
# what SE_SERVARR_INSTANCES names. It is discovered instead, from the adapter'"'"'s
# own instance_specs(), and the whole capture is one remote call because three
# of its outputs are not documents:
#
#   · the FLEET receipt (instances.json), which is configuration rather than an
#     interface reading — captured as name, api and which receipts were absent,
#     and never the URL (location) or the key (a credential DESIGN 21 says must
#     never have been captured at all, since no scrub repairs a payload holding
#     one);
#   · the RESPONSE CODES (response-codes.json), because an app answers some
#     requests with a status and no body — prowlarr'"'"'s /queue is 404 with
#     Content-Length 0 — so the response'"'"'s whole content is its status line and
#     a zero-byte file could not carry it;
#   · the versions, which are per instance and come back with the documents
#     rather than from a separate probe.
#
# The key rides the X-Api-Key header exactly as the adapter sends it, and the
# params are the adapter'"'"'s own constants, so each captured document is the one
# the adapter would have received rather than one this script composed.
servarr_py='
import json, sys, urllib.error, urllib.parse, urllib.request
sys.path.insert(0, "/tmp/secmp/src")
from system_explorer.agent.adapters import servarr

def stem(name, api, path):
    # The payload name the replay seam addresses a fleet document by: the
    # instance and the request path together. Keep in step with slug() in
    # harness/bin/se-reference-collector.
    text = (name + "/api/" + api + path).strip("/")
    keep = [c if (c.isalnum() or c in "-_.") else "-" for c in text]
    return "".join(keep).strip("-").replace("--", "-") or "root"

PATHS = [
    ("/system/status", None),
    ("/health", None),
    ("/queue/status", None),
    ("/queue", dict(page=1, pageSize=servarr.QUEUE_PAGE_SIZE,
                    **servarr.INCLUDE_UNKNOWN)),
    ("/history", servarr.HISTORY_PARAMS),
]

out = {"instances": [], "documents": {}, "response_codes": {}, "versions": []}
for spec in servarr.instance_specs():
    out["instances"].append({"name": spec["name"], "api": spec["api"],
                             "missing": spec["missing"],
                             "duplicates": spec["duplicates"]})
    if spec["missing"]:
        continue
    for path, params in PATHS:
        url = spec["url"] + "/api/" + spec["api"] + path
        if params:
            url = url + "?" + urllib.parse.urlencode(params)
        key = stem(spec["name"], spec["api"], path)
        request = urllib.request.Request(url, headers={"X-Api-Key": spec["key"]})
        try:
            with urllib.request.urlopen(request, timeout=10) as answer:
                out["documents"][key] = json.load(answer)
        except urllib.error.HTTPError as exc:
            out["response_codes"][key] = exc.code
    status = out["documents"].get(stem(spec["name"], spec["api"], "/system/status"))
    if isinstance(status, dict):
        out["versions"].append(str(status.get("appName")) + " "
                               + str(status.get("version")))
print(json.dumps(out))
'
# The local half: one bundle in, one file per document out. Splitting here
# rather than on the guest keeps the remote side a single read-only call and
# puts the refusals — a fleet that named nothing, an instance that answered
# nothing — where the operator can read them.
servarr_split_py='
import json, os, sys
bundle = json.load(sys.stdin)
directory = sys.argv[1]
if not bundle["instances"]:
    sys.exit("SE_SERVARR_INSTANCES named no instances on that guest — a fleet "
             "of nothing is a finding about the configuration, not a capture")
if len(bundle["instances"]) < 2:
    sys.exit("only one instance was configured: every collection fans out over "
             "the fleet, so a one-instance capture cannot exercise the fan-out")
if not bundle["documents"]:
    sys.exit("no instance answered a single path — a finding about the guest, "
             "not a payload to commit")
for stem, document in sorted(bundle["documents"].items()):
    with open(os.path.join(directory, stem + ".json"), "w") as out:
        out.write(json.dumps(document, indent=2) + "\n")
    print("  " + stem + ".json")
for name, document in (("instances", bundle["instances"]),
                       ("response-codes", bundle["response_codes"])):
    with open(os.path.join(directory, name + ".json"), "w") as out:
        out.write(json.dumps(document, indent=2) + "\n")
    print("  " + name + ".json")
'
# The interface version is per instance here, so it comes out of the bundle
# rather than from a probe of its own: "Radarr 6.3.0.10514, Prowlarr 2.5.2.5491"
# names both apps and both releases, which is what a drift diff needs.
servarr_version_py='
import json, sys
print(", ".join(json.load(sys.stdin)["versions"]))
# One command, one connection, the answer verbatim — Kea's control channel IS
# a JSON interface (no socat on the lab image, and a shell pipeline would put
# a transcription between the daemon and the payload). The socket path comes
# from SE_KEA_SOCKET as an ARGUMENT rather than from the environment, because
# reading it needs sudo and sudo resets the environment: the shell expands the
# forwarded variable and sudo carries the value across as argv.
#
# The result member is checked before a byte is written. Kea answers every
# command, including one it does not implement, with a well-formed JSON object
# carrying a non-zero result — so a payload written blind would commit the
# refusal as though it were a reading, and replay would serve it as a broken
# lease table rather than as a collection this guest does not have. 3 is
# CONTROL_RESULT_EMPTY, which is an answer ("the command ran and nothing
# matched") and is exactly what the adapter's own ok=(0, 3) accepts.
kea_py='
import json, socket, sys
path, command = sys.argv[1], sys.argv[2]
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(10.0)
s.connect(path)
s.sendall(json.dumps({"command": command}).encode())
s.shutdown(socket.SHUT_WR)
chunks = []
while True:
    chunk = s.recv(65536)
    if not chunk:
        break
    chunks.append(chunk)
raw = b"".join(chunks).decode()
answer = json.loads(raw)
if isinstance(answer, list):
    answer = answer[0] if answer else {}
if answer.get("result") not in (0, 3):
    sys.stderr.write("kea " + command + " answered " + str(answer.get("result"))
                     + ": " + str(answer.get("text")) + "\n")
    raise SystemExit(1)
sys.stdout.write(raw)
'
# The daemon reporting on itself, which is the build that actually answered the
# socket — `kea-dhcp4 -v` reads the binary on PATH and can name a different one.
kea_version_py='
import json, sys
print("kea " + json.load(sys.stdin)["text"])
'
# The tree-shaped interface, and the only capture here that is not one
# document per command. DESIGN's tree-shape ruling (2026-08-19): the native
# document for a filesystem is the filesystem TRANSCRIBED — the directory
# listings the collector walked plus the contents of every file it read — so
# a reader with the payloads can `cat` any path and compare.
#
# Both halves come from one run of the collector's own walk, with its two
# module-level readers wrapped: that is what makes the capture exactly what
# the adapter reads rather than what somebody thought it reads. A `find`
# would enumerate a different set, and a second pass would sample the
# counters at a second moment.
#
# `null` is a path that was not there and is committed as such: root has no
# memory.current, a cgroup outside the io controller has no io.stat, and
# absent is not empty — the whole collection turns on keeping those apart.
resources_py='
import json, sys
sys.path.insert(0, "/tmp/secmp/src")
from system_explorer.agent.adapters import resources as R
listings, reads = [], {}
real_read, real_walk = R._read_text, R._walk
def walk(root, onerror):
    for entry in real_walk(root, onerror):
        listings.append([entry[0], list(entry[1]), list(entry[2])])
        yield entry
def read(path):
    text = real_read(path)
    reads[path] = text
    return text
R._walk, R._read_text = walk, read
found = R._nodes()
R._unattributed_cpu(found)
print(json.dumps({"root": R.CGROUP_ROOT, "listings": listings, "reads": reads}))
'
# The bundle split into the files the replay seam addresses. Run HERE and not
# on the guest, because the naming rule is the harness'"'"'s: se-reference-collector
# dispatches `_read_text` and `_walk` on their first argument and keys the
# payload on slug(argument), so the file name is the path it answers and a
# reviewer reading one is reading the other.
resources_split_py='
import json, sys
from pathlib import Path

def slug(argument):
    # mirrors slug() in harness/bin/se-reference-collector
    text = str(argument).strip("/")
    keep = [c if (c.isalnum() or c in "-_.") else "-" for c in text]
    return "".join(keep).strip("-").replace("--", "-") or "root"

bundle = json.loads(Path(sys.argv[1]).read_text())
out = Path(sys.argv[2])
written = {}
walk_stem = slug(bundle["root"])
written[walk_stem] = "walk listings"
(out / (walk_stem + ".json")).write_text(json.dumps(bundle["listings"], indent=1) + "\n")
for path, text in sorted(bundle["reads"].items()):
    stem = slug(path)
    if stem in written:
        raise SystemExit("two paths slug to %r: %s and %s" % (stem, written[stem], path))
    written[stem] = path
    if text is None:
        (out / (stem + ".json")).write_text("null\n")
    else:
        (out / (stem + ".txt")).write_text(text)
print("  %d payload files (%d listings, %d paths read)"
      % (len(written), len(bundle["listings"]), len(bundle["reads"])))
'

# The two download-client readers, run as the adapter runs them. `_rpc` is
# the one that has to be borrowed rather than reproduced: transmission refuses
# the first POST with a 409 and hands over X-Transmission-Session-Id, and a
# curl line that did not echo it back would capture the refusal instead of the
# document. `_sab` is borrowed for the opposite reason — sabnzbd takes its key
# as a QUERY PARAMETER, so a curl line here would write the key into this
# file'"'"'s own text; taking the URL from the adapter keeps it in the
# environment, where se-capture-guest already forwards it by name and never
# prints its value.
#
# The payload stem is the seam'"'"'s own addressing: both methods are
# dispatched on their first argument, so se-reference-collector keys each
# document on slug(argument) — session-get, session-stats, torrent-get, queue
# — and a reviewer reading the file name is reading the call it answers.
#
# fullstatus is NOT captured, and its absence is the decision: it is reached
# only by get_evidence, never by acquire, and sabnzbd puts its own `apikey`
# and the host'"'"'s public address in that document. A payload the corpus
# does not need is a payload the scrubber never has to be trusted with.
downloaders_rpc_py='
import asyncio, json, sys
sys.path.insert(0, "/tmp/secmp/src")
from system_explorer.agent.adapters.downloaders import Adapter, TORRENT_FIELDS
method = sys.argv[1]
arguments = {"fields": TORRENT_FIELDS} if method == "torrent-get" else None
print(json.dumps(asyncio.run(Adapter()._rpc(method, arguments))))
'
downloaders_sab_py='
import asyncio, json, sys
sys.path.insert(0, "/tmp/secmp/src")
from system_explorer.agent.adapters.downloaders import Adapter
print(json.dumps(asyncio.run(Adapter()._sab(sys.argv[1]))))
'
# Both clients state their own release, and both are read the way the adapter
# reads them: transmission from session-get, sabnzbd from the queue document
# rather than from fullstatus, so the version probe never touches the one
# document that carries the key.
downloaders_version_py='
import asyncio, json, sys
sys.path.insert(0, "/tmp/secmp/src")
from system_explorer.agent.adapters.downloaders import Adapter
async def main():
    adapter = Adapter()
    session = await adapter._rpc("session-get")
    queue = (await adapter._sab("queue")).get("queue") or {}
    return "transmission " + str(session.get("version")) + " + sabnzbd " + str(queue.get("version"))
print(asyncio.run(main()))
# hardware'"'"'s interface is a TREE, so its payload is the filesystem
# transcribed: every file the walk opened, every directory it enumerated, every
# link it resolved, every hwdb reply it asked for (DESIGN'"'"'s ruling of
# 2026-08-19). There is no single command whose output is that document, and
# there cannot be — the set of paths is decided by what the walk finds — so the
# capture IS the adapter, instrumented: each of its named primitives is wrapped,
# the five collections are acquired once, and the recorded calls are printed
# under the primitive named on the command line.
#
# Recorded WITH ITS NULLS, and that is the point rather than a detail: six HBA
# firmware attribute names are tried per scsi host and at most one exists, so
# "there is no such file" is an ordinary reading the adapter degrades through.
# A null in the document is a captured answer; a path missing from it is one
# nothing observed, and the replay seam refuses that rather than reading the
# tree of whichever machine replays.
#
# Keyed directory-then-name, which is how a reviewer reads it back — `cat` the
# path on the guest and compare one line — and the granularity the scrub
# manifest classifies at.
hardware_py='
import asyncio, json, sys
sys.path.insert(0, "/tmp/secmp/src")
from system_explorer.agent.adapters import hardware

want = sys.argv[1]
seen = {}

def record(name, fn):
    def call(argument):
        answer = fn(argument)
        container, _, member = str(argument).rpartition("/")
        seen.setdefault(name, {}).setdefault(container, {})[member] = answer
        return answer
    return call

for name, attr in (("read", "_read"), ("listdir", "_listdir"),
                   ("realpath", "_realpath"), ("exists", "_exists"),
                   ("udev", "_udev_json"),
                   ("smartctl", "_smartctl_json"),
                   ("smart-snapshot", "_smart_snapshot"),
                   ("smart-reason", "_smart_no_reading")):
    setattr(hardware, attr, record(name, getattr(hardware, attr)))

adapter = hardware.Adapter()

async def walk():
    for collection in adapter.collections():
        await adapter.acquire(collection)

asyncio.run(walk())
print(json.dumps(seen.get(want, {}), indent=1, sort_keys=True))
'
# The name the platform object is published under. socket.gethostname() and not
# `hostname`, because env.HOST reads it that way and the object id is minted
# from it — a capture taken one way and replayed against the other would name
# the object twice.
hostname_py='
import socket
print(socket.gethostname().split(".")[0])
'
declare -a acquisitions
case "$collector" in
    storage)
        acquisitions=(
            "status.json|zpool status -j --json-int"
            "list.json|zpool list -j -p -v -o name,size,alloc,free,cap,frag,health"
            "devlinks.json|python3 -c '$devlinks_py'"
        )
        ;;
    network)
        acquisitions=("nft.json|nft -j list ruleset")
        ;;
    vms)
        # The adapter's own acquisition, run on the guest. _domains_raw is one
        # function that opens the read-only libvirt connection and returns
        # plain dicts — including each domain's XML as a string — so the
        # payload is exactly what the seam hands back, and `virsh dumpxml` is
        # the by-hand command that reproduces its interesting half.
        acquisitions=("domains.json|python3 -c '$vms_py'")
        ;;
    packages)
        acquisitions=(
            "manager.json|python3 -c '$manager_py'"
            "dpkg.json|python3 -c '$dpkg_py'"
        )
        ;;
    resources)
        # One bundle, split below. Privileged: an unprivileged walk cannot
        # read another user's cgroup subtree, and a capture that silently
        # skipped it would replay as a machine running less than it does.
        acquisitions=("_bundle.json|sudo python3 -c '$resources_py'")
        ;;
    docker)
        # The engine API IS the native interface, so each path's response
        # document is the payload, named by the path it answers.
        acquisitions=(
            "containers-json-all-1.json|sudo curl -s --unix-socket /var/run/docker.sock http://docker/containers/json?all=1"
            "volumes.json|sudo curl -s --unix-socket /var/run/docker.sock http://docker/volumes"
            "networks.json|sudo curl -s --unix-socket /var/run/docker.sock http://docker/networks"
        )
        ;;
    bazarr)
        # The app's REST API IS the native interface, so each path's response
        # document is the payload, named by the path that answers it — the same
        # addressing the replay seam derives with slug(), so a reviewer reading
        # api-system-status.json is reading the request it answers.
        #
        # The key rides the header and never the file name, the echo or the
        # query string: `$SE_BAZARR_API_KEY` below is LITERAL in this script and
        # is expanded only by the remote shell, so what this tool prints as it
        # runs is the variable's name. bazarr accepts the key as a header only,
        # which is the posture that keeps a 401 from being a credential channel.
        acquisitions=(
            "api-system-status.json|curl -s -H \"X-API-KEY: \$SE_BAZARR_API_KEY\" \"\$SE_BAZARR_URL/api/system/status\""
            "api-system-health.json|curl -s -H \"X-API-KEY: \$SE_BAZARR_API_KEY\" \"\$SE_BAZARR_URL/api/system/health\""
        )
        ;;
    traefik)
        acquisitions=(
            "api-overview.json|curl -s \"\$SE_TRAEFIK_URL/api/overview\""
            "api-version.json|curl -s \"\$SE_TRAEFIK_URL/api/version\""
            "api-entrypoints.json|curl -s \"\$SE_TRAEFIK_URL/api/entrypoints?page=1&per_page=100\""
            "api-http-routers.json|curl -s \"\$SE_TRAEFIK_URL/api/http/routers?page=1&per_page=100\""
            "api-http-services.json|curl -s \"\$SE_TRAEFIK_URL/api/http/services?page=1&per_page=100\""
        )
        ;;
    logs)
        # The payload name is the seam's own addressing, not a label somebody
        # chose: _run_journalctl is dispatched on its ARGUMENT, so
        # se-reference-collector keys the document on slug(["-r","-n","100"])
        # — `r---n--100` — and a reviewer reading the file name is reading the
        # argv it answers. Renaming it to something prettier would make the
        # replay seam raise "not captured in this variant" against a file
        # sitting right beside it.
        acquisitions=("r---n--100.json|sudo python3 -c '$logs_py'")
        ;;
    hardware)
        # Seven instrumented runs and two commands. Seven because each payload
        # is one file and the tool's contract is one command per file; the walk
        # is read-only and deterministic on a quiescent guest, so seven runs
        # record the same calls. lscpu answers with a document already, so it
        # is captured by the command a reader would run themselves.
        acquisitions=(
            "read.json|python3 -c '$hardware_py' read"
            "listdir.json|python3 -c '$hardware_py' listdir"
            "realpath.json|python3 -c '$hardware_py' realpath"
            "exists.json|python3 -c '$hardware_py' exists"
            "udev.json|python3 -c '$hardware_py' udev"
            "smartctl.json|python3 -c '$hardware_py' smartctl"
            "smart-snapshot.json|python3 -c '$hardware_py' smart-snapshot"
            "smart-reason.json|python3 -c '$hardware_py' smart-reason"
            "lscpu.json|lscpu -J"
            "hostname|python3 -c '$hostname_py'"
        )
        ;;
    unbound)
        # unbound-control speaks the control socket for us, and prints the
        # reply verbatim — which is exactly what the adapter's _command
        # returns, so the captured bytes are the document the parser sees.
        # stats_noreset and never stats: the plain command zeroes every
        # counter it reports, so capturing with it would destroy the reading
        # on the guest it came from.
        acquisitions=(
            "status.txt|sudo unbound-control status"
            "stats_noreset.txt|sudo unbound-control stats_noreset"
        )
        ;;
    servarr)
        # No entries: the fleet's documents cannot be enumerated ahead of the
        # capture, so the servarr branch below does the whole of it in one
        # remote call. The empty list keeps the shared loop a no-op rather
        # than growing a second dialect inside it.
        acquisitions=()
        ;;
    kea)
        # Five commands, five documents, keyed on the command — the argument
        # that decides which document comes back, which is what the dispatched
        # seam keys its payloads on. list-commands is on the PROBE path rather
        # than the acquisition path and is captured anyway: it is the document
        # the leases gate reads, so committing it is what makes "this Kea
        # offers no lease4-get-all" evidence a reviewer can check instead of a
        # sentence in a note.
        acquisitions=(
            "version-get.json|sudo python3 -c '$kea_py' \"\$SE_KEA_SOCKET\" version-get"
            "status-get.json|sudo python3 -c '$kea_py' \"\$SE_KEA_SOCKET\" status-get"
            "statistic-get-all.json|sudo python3 -c '$kea_py' \"\$SE_KEA_SOCKET\" statistic-get-all"
            "config-get.json|sudo python3 -c '$kea_py' \"\$SE_KEA_SOCKET\" config-get"
            "list-commands.json|sudo python3 -c '$kea_py' \"\$SE_KEA_SOCKET\" list-commands"
    downloaders)
        # Four documents, and every one of them is on the ACQUISITION path.
        # Both clients are asked, because the instance gates in the replay
        # seam pin a two-client host: a variant that staged one client's
        # documents and not the other's would replay as a client that could
        # not be asked, which is a broken capture wearing a dark client's
        # face.
        acquisitions=(
            "session-get.json|python3 -c '$downloaders_rpc_py' session-get"
            "session-stats.json|python3 -c '$downloaders_rpc_py' session-stats"
            "torrent-get.json|python3 -c '$downloaders_rpc_py' torrent-get"
            "queue.json|python3 -c '$downloaders_sab_py' queue"
        )
        ;;
    *)
        echo "unknown collector '$collector'" >&2
        exit 2
        ;;
esac

version_probe=""
case "$collector" in
    storage) version_probe="zfs version | head -1" ;;
    network) version_probe="nft --version" ;;
    vms) version_probe="virsh --version" ;;
    packages) version_probe="dpkg-query --version 2>/dev/null | head -1 || rpm --version" ;;
    docker) version_probe="sudo docker --version" ;;
    # journalctl is systemd's own binary and reports systemd's version, which
    # is the version the FIELD SET is a fact about — a journal entry's members
    # are decided by the systemd that wrote it, not by any separate tool.
    logs) version_probe="journalctl --version | head -1" ;;
    # The kernel is the interface here: cgroup v2's file set, the PSI files
    # and their fields are decided by the kernel that presents them, not by
    # any userspace tool, so the kernel release is the version a drift diff
    # is a fact about.
    resources) version_probe="echo linux \$(uname -r)" ;;
    # The daemon reporting on itself, which is the version that actually
    # answered the socket — `unbound -V` reads the binary on PATH and can name
    # a different build from the one running.
    unbound) version_probe="sudo unbound-control status | sed -n '1s/^version: /unbound /p'" ;;
    # Three producers, because the payload has three: the kernel lays out
    # sysfs, udev's hwdb supplies every vendor and model name the walk joins on,
    # and util-linux is what `lscpu -J` is. A field's presence here is a fact
    # about whichever of the three added it.
    hardware) version_probe='echo "linux-$(uname -r) udev-$(udevadm --version) util-linux-$(lscpu --version | grep -o "[0-9.]*$")"' ;;
    traefik) version_probe="curl -s \"\$SE_TRAEFIK_URL/api/version\" | head -c 120" ;;
    # The instance reporting on itself, which is the build that actually
    # answered — a container tag or a package name would say what was deployed,
    # and those two disagree the moment an image is repulled without a restart.
    bazarr) version_probe="curl -s -H \"X-API-KEY: \$SE_BAZARR_API_KEY\" \"\$SE_BAZARR_URL/api/system/status\" | python3 -c 'import json,sys; print(\"bazarr\", json.load(sys.stdin)[\"data\"][\"bazarr_version\"])'" ;;
    kea) version_probe="sudo python3 -c '$kea_py' \"\$SE_KEA_SOCKET\" version-get | python3 -c '$kea_version_py'" ;;
    # Two clients, two releases, one line: a downloaders capture is a fact
    # about both, and a source_version naming one of them could not tell a
    # drift diff which half moved.
    downloaders) version_probe="python3 -c '$downloaders_version_py'" ;;
esac

# Forward the caller's SE_* variables to the guest. Every HTTP-interface
# collector is addressed by environment — SE_TRAEFIK_URL, SE_SONARR_API_KEY —
# exactly as the shipping agent addresses it, so a capture that could not
# carry them would be able to reach only the credential-free interfaces. They
# are passed as a prefix on the remote command rather than through
# SendEnv/AcceptEnv, which needs sshd's cooperation on every guest.
remote_env=""
while IFS='=' read -r key value; do
    [[ $key == SE_* ]] || continue
    # `export K=V; cmd` and not `K=V cmd`: in the second form the shell
    # expands $K inside cmd BEFORE the assignment takes effect, so an
    # acquisition that names its own variable reads an empty string and
    # curl cheerfully exits 0 having fetched nothing.
    remote_env+="export $key=$(printf '%q' "$value"); "
done < <(env)
[[ -n $remote_env ]] && echo "  forwarding: $(echo "$remote_env" | tr ';' '\n' | sed -n 's/^ *export \([A-Z_]*\)=.*/\1/p' | tr '\n' ' ')"

# The one acquisition that is not a property of the interface's VERSION but of
# the guest's configuration. `lease4-get-all` ships in libdhcp_lease_cmds, a
# hook library, so a Kea with no hooks loaded does not offer the command at all
# — which is the same gate the adapter's capability() applies, and the reason
# it names the hook instead of erroring every collect. Asked of the daemon
# rather than assumed, and asked here because it needs the forwarded
# environment above: on a guest that loads the hook the payload is captured
# like any other, and on one that does not, the leases collection has no
# interface to capture and the run says so instead of committing a refusal.
if [[ $collector == kea ]]; then
    if ssh "${ssh_opts[@]}" -- "$target" \
        "${remote_env}sudo python3 -c '$kea_py' \"\$SE_KEA_SOCKET\" list-commands" \
        | grep -q '"lease4-get-all"'; then
        acquisitions+=("lease4-get-all.json|sudo python3 -c '$kea_py' \"\$SE_KEA_SOCKET\" lease4-get-all")
    else
        echo "  note: this Kea offers no lease4-get-all — libdhcp_lease_cmds is not" >&2
        echo "  loaded, so the leases collection has no interface on this guest and" >&2
        echo "  no payload is captured for it. A variant staged here therefore opens" >&2
        echo "  three collections, not four." >&2
    fi
fi

echo "capturing $collector from $target"
for entry in "${acquisitions[@]}"; do
    file="${entry%%|*}"
    command="${entry#*|}"
    echo "  $file  <-  $command"
    if ! ssh "${ssh_opts[@]}" -- "$target" "$remote_env$command" > "$payload_dir/$file"; then
        echo "  FAILED: $command" >&2
        echo "  A collector that cannot read its interface on this guest is a" >&2
        echo "  finding about the guest, not a payload to commit." >&2
        rm -f "$payload_dir/$file"
        exit 1
    fi
    if [[ $file == *.json ]]; then
        if ! python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$payload_dir/$file"; then
            echo "  FAILED: $file is not JSON — text-scraping is forbidden (DESIGN 18)" >&2
            exit 1
        fi
    # A .txt payload is a line protocol or a kernel file, and it is held to
    # being NON-EMPTY rather than to a grammar: an interface that answered
    # with nothing produced no document, and committing zero bytes would
    # replay as an absent interface on a guest where it was present.
    elif [[ ! -s $payload_dir/$file ]]; then
        echo "  FAILED: $file came back empty — an interface that answered" >&2
        echo "  with nothing is a finding about the guest, not a payload." >&2
        rm -f "$payload_dir/$file"
        exit 1
    fi
done

# The fleet capture: one remote call, split locally. It is its own branch
# rather than a row in the table above because what it writes is not one
# document per acquisition — see servarr_py.
source_version=""
if [[ $collector == servarr ]]; then
    echo "  the fleet  <-  python3 -c '<servarr_py>'  (instance_specs, then every path)"
    if ! bundle="$(ssh "${ssh_opts[@]}" -- "$target" "$remote_env python3 -c '$servarr_py'")"; then
        echo "  FAILED: the fleet capture did not run on $target" >&2
        echo "  A collector that cannot read its interface on this guest is a" >&2
        echo "  finding about the guest, not a payload to commit." >&2
        exit 1
    fi
    if ! printf '%s' "$bundle" | python3 -c "$servarr_split_py" "$payload_dir"; then
        exit 1
    fi
    source_version="$(printf '%s' "$bundle" | python3 -c "$servarr_version_py")"
fi

if [[ -n $version_probe ]]; then
    source_version="$(ssh "${ssh_opts[@]}" -- "$target" "set -o pipefail; $remote_env$version_probe" | tr -d '\r')"
fi
if [[ $collector == resources ]]; then
    python3 -c "$resources_split_py" "$payload_dir/_bundle.json" "$payload_dir"
    rm -f "$payload_dir/_bundle.json"
fi

source_version="$(ssh "${ssh_opts[@]}" -- "$target" "set -o pipefail; $remote_env$version_probe" | tr -d '\r')"
if [[ -z $source_version ]]; then
    echo "could not read the interface version on $target — a capture whose" >&2
    echo "source_version is unknown cannot tell a drift diff what changed." >&2
    exit 1
fi
os_release="$(ssh "${ssh_opts[@]}" -- "$target" '. /etc/os-release && echo "$ID|$VERSION_ID"' | tr -d '\r')"

cat <<EOF

captured to $payload_dir
  source_version : $source_version
  os             : ${os_release%%|*}
  os_version     : ${os_release##*|}

Next:
  1. scrub the payloads — serials, WWNs, MACs, hostnames, paths — preserving
     structural consistency across every file in this variant
  2. harness/bin/se-anonymise --manifest harness/scrub/$collector.json \\
       --hostnames <real,names> \\
       --map ~/.local/state/se/scrub/<variant>.json $payload_dir/*
     (the manifest is required — the scrubber no longer guesses a value's
      class from its shape; the map de-anonymises every specimen it keyed,
      and is refused anywhere inside a git working tree)
  3. write $variant/meta.json with the values above, the variant name, whether
     the lab can re-stage it, and any planted canaries
  4. harness/bin/se-capture --write $variant
  5. read the diff before committing it
EOF
